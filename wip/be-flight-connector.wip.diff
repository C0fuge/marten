+constexpr const char* kReuseConnectionScheme = "arrow-flight-reuse-connection";
+
+// Errors that mean "the server could not be reached": only these move a stream to the next location,
+// and only while nothing has been delivered yet. Server errors are final.
+bool is_unreachable(const arrow::Status& st) {
+    if (st.ok()) {
+        return false;
+    }
+    auto detail = arrow::flight::FlightStatusDetail::UnwrapStatus(st);
+    if (detail != nullptr) {
+        return detail->code() == arrow::flight::FlightStatusCode::Unavailable ||
+               detail->code() == arrow::flight::FlightStatusCode::TimedOut;
+    }
+    return st.IsIOError();
+}
+
+bool iequals(const std::string& a, const std::string& b) {
+    return a.size() == b.size() && std::equal(a.begin(), a.end(), b.begin(), [](char x, char y) {
+               return std::tolower(static_cast<unsigned char>(x)) == std::tolower(static_cast<unsigned char>(y));
+           });
+}
+
+// One thread per process that cancels the gRPC streams of cancelled queries. A data source blocked in
+// FlightStreamReader::Next() cannot see the cancellation itself; Cancel() (gRPC TryCancel) wakes it up.
+class FlightCancelWatcher {
+public:
+    static FlightCancelWatcher* instance() {
+        static auto* watcher = new FlightCancelWatcher();
+        return watcher;
+    }
+
+    void add(FlightDataSource* source) {
+        std::lock_guard<std::mutex> l(_lock);
+        _sources.insert(source);
+        if (!_started) {
+            _started = true;
+            std::thread([this] { _run(); }).detach();
+        }
+    }
+
+    void remove(FlightDataSource* source) {
+        std::lock_guard<std::mutex> l(_lock);
+        _sources.erase(source);
+    }
+
+private:
+    void _run() {
+        while (true) {
+            std::this_thread::sleep_for(std::chrono::milliseconds(200));
+            std::lock_guard<std::mutex> l(_lock);
+            for (auto* source : _sources) {
+                RuntimeState* state = source->runtime_state();
+                if (state != nullptr && state->is_cancelled()) {
+                    source->cancel_stream();
+                }
+            }
+        }
+    }
+
+    std::mutex _lock;
+    std::unordered_set<FlightDataSource*> _sources;
+    bool _started = false;
+};
+
+} // namespace
