+        Statistics connectorStats = null;
+        try {
+            connectorStats = GlobalStateMgr.getCurrentState().getMetadataMgr().getTableStatistics(
+                    optimizerContext, table.getCatalogName(), table, columnRefOperatorColumnMap,
+                    Collections.emptyList(), null);
+            if (connectorStats != null && !Double.isNaN(connectorStats.getOutputRowCount())) {
+                rowCount = Math.max(1, (long) connectorStats.getOutputRowCount());
+                source = connectorStats.getStatsSource();
+            }
+        } catch (Exception e) {
+            LOG.warn("Failed to get Flight table statistics for {}: {}", table.getName(), e.getMessage());
+        }
+        if (aggregation != null) {
+            // partial groups returned by the server (one set per endpoint)
+            rowCount = aggregation.getGroupBy().isEmpty() ? 1 : Math.max(1, rowCount / 10);
+            return computeNormalExternalTableScanNode(node, context, table, columnRefOperatorColumnMap, rowCount,
+                    source);
+        }
+        Statistics.Builder builder =
+                StatisticsCalcUtils.estimateScanColumns(table, columnRefOperatorColumnMap, optimizerContext);
+        if (connectorStats != null) {
+            // column min/max from the server (flight.column_stats); the predicate is estimated on them below
+            for (Map.Entry<ColumnRefOperator, ColumnStatistic> e : connectorStats.getColumnStatistics().entrySet()) {
