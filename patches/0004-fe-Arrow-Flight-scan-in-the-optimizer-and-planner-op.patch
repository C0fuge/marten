+import com.starrocks.sql.optimizer.rule.RuleType;
+import com.starrocks.type.Type;
+import org.apache.logging.log4j.LogManager;
+import org.apache.logging.log4j.Logger;
+
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Optional;
+import java.util.TreeSet;
+
+/**
+ * Join-key pushdown between two Arrow Flight scans (TPC-H q17, q19):
+ * <pre>
+ *   Join(a.k = b.k) -> FlightScan(a), FlightScan(b, predicate)
+ * =>
+ *   Join(a.k = b.k) -> FlightScan(a, a.k IN (keys of b)), FlightScan(b, predicate)
+ * </pre>
+ * At planning time the rule asks the server for the distinct join keys of the filtered side
+ * ({@code SELECT "k" FROM b WHERE ... GROUP BY "k" LIMIT max+1}, bounded by
+ * {@code flight.pushdown.join_keys_timeout_ms}). Up to {@code flight.pushdown.join_keys} keys become an IN
+ * conjunct of the other scan; more keys become a min/max range. The conjunct is an ordinary scan predicate, so the
+ * Flight scan renders it into its remote SQL and the BE re-checks it. The keys of the filtered side are a superset
+ * of the keys that can match (conjuncts the server cannot evaluate are left out of the key query), so the result
+ * is unchanged; the conjunct only goes to a side whose unmatched rows the join drops (inner and semi joins: either
+ * side; left outer: the right side; right outer: the left side). Only integer keys of the same type on both sides.
+ * <p>
+ * Unlike a runtime filter, which the BE applies after the rows were streamed, this filter reaches the server: the
+ * Flight tickets are fixed at planning time, so a filter known only at execution time cannot be added to them.
+ * Runs once before the aggregation pushdown (see QueryOptimizer); any failure or timeout leaves the plan unchanged.
+ */
+public class FlightJoinKeyPushdownRule extends TransformationRule {
+    private static final Logger LOG = LogManager.getLogger(FlightJoinKeyPushdownRule.class);
+
+    public static final FlightJoinKeyPushdownRule INSTANCE = new FlightJoinKeyPushdownRule();
+
+    private FlightJoinKeyPushdownRule() {
+        super(RuleType.TF_FLIGHT_JOIN_KEY_PUSHDOWN, Pattern.create(OperatorType.LOGICAL_JOIN)
+                .addChildren(Pattern.create(OperatorType.LOGICAL_FLIGHT_SCAN),
+                        Pattern.create(OperatorType.LOGICAL_FLIGHT_SCAN)));
+    }
+
+    @Override
+    public boolean check(OptExpression input, OptimizerContext context) {
+        LogicalJoinOperator join = (LogicalJoinOperator) input.getOp();
+        if (!context.getSessionVariable().isFlightJoinKeyPushdown()
+                || !context.getSessionVariable().isFlightFilterPushdown()
+                || join.getOnPredicate() == null) {
+            return false;
+        }
+        JoinOperator type = join.getJoinType();
+        return type.isInnerJoin() || type.isSemiJoin() || type.isLeftOuterJoin() || type.isRightOuterJoin();
+    }
+
+    private static FlightProperties properties(LogicalFlightScanOperator scan) {
+        FlightMetadata metadata = metadata(scan);
+        return metadata == null ? null : metadata.getProperties();
+    }
+
+    /** The catalog's metadata as the metadata manager hands it out (a test registers its own), else the connector's. */
+    private static FlightMetadata metadata(LogicalFlightScanOperator scan) {
+        if (!(scan.getTable() instanceof FlightTable)) {
+            return null;
+        }
+        String catalog = ((FlightTable) scan.getTable()).getCatalogName();
+        Optional<ConnectorMetadata> m = GlobalStateMgr.getCurrentState().getMetadataMgr().getOptionalMetadata(catalog);
+        if (m.isPresent() && m.get() instanceof FlightMetadata) {
+            return (FlightMetadata) m.get();
+        }
+        return FlightConnector.metadataOf(catalog);
+    }
+
+    /** Scan column behind an output column of the scan (through an identity projection), or null. */
+    private static ColumnRefOperator scanColumn(LogicalFlightScanOperator scan, ColumnRefOperator out) {
+        ColumnRefOperator ref = out;
+        if (scan.getProjection() != null) {
+            ScalarOperator v = scan.getProjection().getColumnRefMap().get(out);
+            if (!(v instanceof ColumnRefOperator)) {
+                return null;
+            }
+            ref = (ColumnRefOperator) v;
+        }
+        return scan.getColRefToColumnMetaMap().containsKey(ref) ? ref : null;
+    }
+
+    private static boolean usable(LogicalFlightScanOperator scan) {
+        FlightProperties props = properties(scan);
+        return props != null && props.isFilterPushdown() && props.getJoinKeyPushdownMax() > 0
+                && scan.getAggregationPushdown() == null && scan.getLimit() < 0;
+    }
+
+    private static boolean isIntegerKey(Type t) {
+        switch (t.getPrimitiveType()) {
+            case TINYINT:
+            case SMALLINT:
+            case INT:
+            case BIGINT:
+                return true;
+            default:
+                return false;
+        }
+    }
+
+    @Override
+    public List<OptExpression> transform(OptExpression input, OptimizerContext context) {
+        LogicalJoinOperator join = (LogicalJoinOperator) input.getOp();
+        LogicalFlightScanOperator left = (LogicalFlightScanOperator) input.inputAt(0).getOp();
+        LogicalFlightScanOperator right = (LogicalFlightScanOperator) input.inputAt(1).getOp();
+        if (!usable(left) || !usable(right)) {
+            return Collections.emptyList();
+        }
+        JoinOperator type = join.getJoinType();
+        boolean leftMayBeTarget = !type.isLeftOuterJoin();
+        boolean rightMayBeTarget = !type.isRightOuterJoin();
+
+        // the source is the filtered side; with both filtered, the smaller table
+        boolean leftFiltered = left.getPredicate() != null;
+        boolean rightFiltered = right.getPredicate() != null;
+        boolean sourceIsLeft;
+        if (leftFiltered && rightFiltered) {
+            sourceIsLeft = metadata(left).getRowCount((FlightTable) left.getTable())
+                    <= metadata(right).getRowCount((FlightTable) right.getTable());
+        } else if (leftFiltered || rightFiltered) {
+            sourceIsLeft = leftFiltered;
+        } else {
+            return Collections.emptyList();
+        }
+        if (sourceIsLeft ? !rightMayBeTarget : !leftMayBeTarget) {
+            return Collections.emptyList();
+        }
+        LogicalFlightScanOperator source = sourceIsLeft ? left : right;
+        LogicalFlightScanOperator target = sourceIsLeft ? right : left;
+
+        // the first integer equi-join key with the same type on both sides
+        ColumnRefOperator sourceKey = null;
+        ColumnRefOperator targetKey = null;
+        for (ScalarOperator conjunct : Utils.extractConjuncts(join.getOnPredicate())) {
+            if (!(conjunct instanceof BinaryPredicateOperator)
+                    || ((BinaryPredicateOperator) conjunct).getBinaryType() != BinaryType.EQ
+                    || !(conjunct.getChild(0) instanceof ColumnRefOperator)
+                    || !(conjunct.getChild(1) instanceof ColumnRefOperator)) {
+                continue;
+            }
+            ColumnRefOperator c0 = (ColumnRefOperator) conjunct.getChild(0);
+            ColumnRefOperator c1 = (ColumnRefOperator) conjunct.getChild(1);
+            for (int swap = 0; swap < 2 && sourceKey == null; swap++) {
+                ColumnRefOperator s = scanColumn(source, swap == 0 ? c0 : c1);
+                ColumnRefOperator t = scanColumn(target, swap == 0 ? c1 : c0);
+                if (s != null && t != null && isIntegerKey(s.getType()) && s.getType().equals(t.getType())
+                        && ((FlightTable) source.getTable()).isFilterable(
+                        source.getColRefToColumnMetaMap().get(s).getName())
+                        && ((FlightTable) target.getTable()).isFilterable(
+                        target.getColRefToColumnMetaMap().get(t).getName())) {
+                    sourceKey = s;
+                    targetKey = t;
+                }
+            }
+            if (sourceKey != null) {
+                break;
+            }
+        }
+        if (sourceKey == null) {
+            return Collections.emptyList();
+        }
+
+        String sql = keySql(source, sourceKey, properties(source).getJoinKeyPushdownMax());
+        if (sql == null) {
+            return Collections.emptyList();
+        }
+        ScalarOperator filter;
+        try {
+            filter = keyFilter(metadata(source), sql, source, sourceKey, targetKey);
+        } catch (Exception e) {
+            LOG.warn("Flight join-key pushdown skipped for {}: {}", source.getTable().getName(), e.getMessage());
+            return Collections.emptyList();
+        }
+        if (filter == null) {
+            return Collections.emptyList();
+        }
+        LogicalFlightScanOperator newTarget = new LogicalFlightScanOperator.Builder().withOperator(target).build();
+        newTarget.setPredicate(Utils.compoundAnd(target.getPredicate(), filter));
+        OptExpression targetExpr = OptExpression.create(newTarget);
+        OptExpression sourceExpr = sourceIsLeft ? input.inputAt(0) : input.inputAt(1);
+        return Collections.singletonList(OptExpression.create(join,
+                sourceIsLeft ? sourceExpr : targetExpr, sourceIsLeft ? targetExpr : sourceExpr));
+    }
+
+    /** {@code SELECT "k" FROM source WHERE <renderable conjuncts> GROUP BY "k" LIMIT max+1}, or null. */
+    @VisibleForTesting
+    static String keySql(LogicalFlightScanOperator source, ColumnRefOperator key, int maxKeys) {
+        FlightTable table = (FlightTable) source.getTable();
+        Map<ColumnRefOperator, String> pushable = new HashMap<>();
+        for (Map.Entry<ColumnRefOperator, Column> e : source.getColRefToColumnMetaMap().entrySet()) {
+            if (table.isFilterable(e.getValue().getName())) {
+                pushable.put(e.getKey(), e.getValue().getName());
+            }
+        }
+        FlightSqlRenderer.Columns cols = FlightSqlRenderer.columns(pushable);
+        List<String> where = new ArrayList<>();
+        for (ScalarOperator conjunct : Utils.extractConjuncts(source.getPredicate())) {
+            String p = FlightSqlRenderer.predicate(conjunct, cols);
+            if (p != null) {
+                where.add(p);
+            }
+        }
+        if (where.isEmpty()) {
+            // nothing reduces the keys
+            return null;
+        }
+        String name = source.getColRefToColumnMetaMap().get(key).getName();
+        List<FlightSqlRenderer.SelectItem> items =
+                List.of(new FlightSqlRenderer.SelectItem(FlightSqlRenderer.quoteIdent(name), null));
+        return FlightSqlRenderer.select(table.getCatalogDBName(), table.getCatalogTableName(), source.getTimeTravel(),
+                items, where, List.of(name), maxKeys + 1L, false);
+    }
+
+    private static Long longValue(Object o) {
+        return o instanceof Number ? ((Number) o).longValue() : null;
+    }
+
+    /** IN list or range conjunct on {@code targetKey}, or null when the keys do not reduce anything. */
+    private static ScalarOperator keyFilter(FlightMetadata metadata, String sql, LogicalFlightScanOperator source,
+                                            ColumnRefOperator sourceKey, ColumnRefOperator targetKey) {
+        FlightProperties props = metadata.getProperties();
+        int maxKeys = props.getJoinKeyPushdownMax();
+        long timeoutMs = props.getJoinKeyPushdownTimeoutMs();
+        List<Object[]> rows = metadata.getClient().queryRows(sql, (v, row) -> v.getObject(row), timeoutMs);
+        // result mode partial: every endpoint returns its own distinct keys (and its own LIMIT)
+        TreeSet<Long> keys = new TreeSet<>();
+        boolean truncated = false;
+        for (Object[] row : rows) {
+            Long k = row.length == 1 ? longValue(row[0]) : null;
+            if (k != null) {
+                keys.add(k);
+            }
+            if (keys.size() > maxKeys) {
+                truncated = true;
+                break;
+            }
+        }
+        if (!truncated) {
+            if (keys.isEmpty()) {
+                // no key passes the filter (or only NULLs): the join is empty; left to the BE
+                return null;
+            }
+            List<ScalarOperator> args = new ArrayList<>();
+            args.add(targetKey);
+            for (Long k : keys) {
+                args.add(constant(targetKey.getType(), k));
+            }
+            return new InPredicateOperator(false, args);
+        }
+        // too many keys: their range
+        String rangeSql = sql.replaceFirst("^SELECT (\"(?:[^\"]|\"\")*\") FROM", "SELECT min($1), max($1) FROM");
+        int groupBy = rangeSql.lastIndexOf(" GROUP BY ");
+        if (rangeSql.equals(sql) || groupBy < 0) {
+            return null;
+        }
+        rangeSql = rangeSql.substring(0, groupBy);
+        Long min = null;
+        Long max = null;
+        for (Object[] row : metadata.getClient().queryRows(rangeSql, (v, row) -> v.getObject(row), timeoutMs)) {
+            if (row.length != 2) {
+                return null;
+            }
+            Long lo = longValue(row[0]);
+            Long hi = longValue(row[1]);
+            if (lo != null) {
+                min = min == null ? lo : Math.min(min, lo);
+            }
+            if (hi != null) {
+                max = max == null ? hi : Math.max(max, hi);
+            }
+        }
+        if (min == null || max == null) {
+            return null;
+        }
+        return Utils.compoundAnd(
+                new BinaryPredicateOperator(BinaryType.GE, targetKey, constant(targetKey.getType(), min)),
+                new BinaryPredicateOperator(BinaryType.LE, targetKey, constant(targetKey.getType(), max)));
+    }
+
+    private static ConstantOperator constant(Type type, long v) {
+        switch (type.getPrimitiveType()) {
+            case TINYINT:
+                return ConstantOperator.createTinyInt((byte) v);
+            case SMALLINT:
+                return ConstantOperator.createSmallInt((short) v);
+            case INT:
+                return ConstantOperator.createInt((int) v);
+            default:
+                return ConstantOperator.createBigint(v);
+        }
+    }
+}
