+    // Flight tables forward a point in time to the server: FOR VERSION AS OF <id> / FOR TIMESTAMP AS OF <datetime>
+    private String flightTimeTravel(QueryPeriod queryPeriod) {
+        if (queryPeriod == null || queryPeriod.getStart().isPresent() || queryPeriod.getEnd().isEmpty()) {
+            throw new SemanticException("Arrow Flight tables support only FOR VERSION AS OF <snapshot id> " +
+                    "and FOR TIMESTAMP AS OF <datetime>");
+        }
+        boolean version = queryPeriod.getPeriodType() == QueryPeriod.PeriodType.VERSION;
+        ConnectorTableVersion v = resolveQueryPeriod(queryPeriod.getEnd(), queryPeriod.getPeriodType()).get();
+        String clause = FlightSqlRenderer.timeTravel(version, v.getConstantOperator(),
+                TimeUtils.getTimeZone().toZoneId());
+        if (clause == null) {
+            throw new SemanticException("Invalid %s for an Arrow Flight table: %s (expected %s)",
+                    version ? "version" : "timestamp", v.getConstantOperator(),
+                    version ? "an integer snapshot id" : "a datetime");
+        }
+        return clause;
+    }
