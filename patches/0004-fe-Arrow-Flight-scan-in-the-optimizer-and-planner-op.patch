+
+/**
+ * Pushes a GROUP BY aggregation (count, sum, min, max, avg) over an Arrow Flight scan to the Flight SQL server:
+ * <pre>
+ *   Agg(g, count(*), sum(x)) -> FlightScan(g, x, predicate)
+ * =>
+ *   Agg(g, sum(c0), sum(c1)) -> FlightScan(g, c0, c1) with remote
+ *   SELECT "g", count(*) AS "__flight_agg_0", sum(CAST("x" AS T)) AS "__flight_agg_1" FROM t WHERE ... GROUP BY "g"
+ * </pre>
+ * Every remote select item is a bare {@code fn(expr) AS alias}: in result mode {@code partial} the server rewrites
+ * the aggregates per endpoint and rejects anything wrapped around them (M4 run 39658484728: "Referenced column
+ * cast(sum(...)) not found"). Casts therefore go inside the aggregate, which keeps the server's result type equal
+ * to the StarRocks partial type for decimal and floating-point sums and for min/max; an integer sum (the server
+ * widens it to HUGEINT) needs a cast around it and is only pushed in result mode {@code complete}.
+ * Every endpoint returns partial groups; the StarRocks aggregation merges them (count -> sum, sum -> sum,
+ * min -> min, max -> max; avg(x) is pushed as sum(x) and count(x) and becomes their quotient, as in the
+ * materialized-view rewrite). The rule only fires when every conjunct of the scan predicate, every grouping key and
+ * every aggregate argument can be rendered exactly; otherwise the plan is left unchanged.
+ * Runs once after the projections were merged into their operators (see QueryOptimizer).
+ */
+public class FlightAggregationPushdownRule extends TransformationRule {
+    public static final FlightAggregationPushdownRule INSTANCE = new FlightAggregationPushdownRule();
+
+    private static final Set<String> FUNCTIONS =
+            ImmutableSet.of(FunctionSet.COUNT, FunctionSet.SUM, FunctionSet.MIN, FunctionSet.MAX, FunctionSet.AVG);
+
+    private FlightAggregationPushdownRule() {
+        super(RuleType.TF_FLIGHT_AGGREGATION_PUSHDOWN, Pattern.create(OperatorType.LOGICAL_AGGR)
+                .addChildren(Pattern.create(OperatorType.LOGICAL_FLIGHT_SCAN)));
+    }
+
+    @Override
+    public boolean check(OptExpression input, OptimizerContext context) {
+        LogicalAggregationOperator agg = (LogicalAggregationOperator) input.getOp();
+        LogicalFlightScanOperator scan = (LogicalFlightScanOperator) input.inputAt(0).getOp();
+        if (!context.getSessionVariable().isFlightAggregatePushdown() || !agg.getType().isGlobal() || agg.isSplit()) {
+            return false;
+        }
+        if (scan.getAggregationPushdown() != null || scan.getLimit() >= 0
+                || !(scan.getTable() instanceof FlightTable)) {
+            return false;
+        }
+        if (scan.getProjection() != null && !scan.getProjection().getCommonSubOperatorMap().isEmpty()) {
+            return false;
+        }
+        FlightProperties props = properties((FlightTable) scan.getTable());
+        return props != null && props.isAggregatePushdown();
+    }
+
+    private static FlightProperties properties(FlightTable table) {
+        FlightMetadata metadata = FlightConnector.metadataOf(table.getCatalogName());
+        return metadata == null ? null : metadata.getProperties();
+    }
+
+    @Override
+    public List<OptExpression> transform(OptExpression input, OptimizerContext context) {
+        LogicalAggregationOperator agg = (LogicalAggregationOperator) input.getOp();
+        LogicalFlightScanOperator scan = (LogicalFlightScanOperator) input.inputAt(0).getOp();
+        FlightTable table = (FlightTable) scan.getTable();
+        FlightProperties props = properties(table);
+        ColumnRefFactory factory = context.getColumnRefFactory();
+        Map<ColumnRefOperator, Column> scanColumns = scan.getColRefToColumnMetaMap();
+
+        Map<ColumnRefOperator, String> pushable = new HashMap<>();
+        for (Map.Entry<ColumnRefOperator, Column> e : scanColumns.entrySet()) {
+            if (table.isFilterable(e.getValue().getName())) {
+                pushable.put(e.getKey(), e.getValue().getName());
+            }
+        }
+        FlightSqlRenderer.Columns cols = FlightSqlRenderer.columns(pushable);
+        Map<ColumnRefOperator, ScalarOperator> projection = scan.getProjection() == null ? null :
+                scan.getProjection().getColumnRefMap();
+        ReplaceColumnRefRewriter resolver = projection == null ? null : new ReplaceColumnRefRewriter(projection);
+
+        // WHERE: every conjunct, since the server aggregates the filtered rows
+        List<String> where = new ArrayList<>();
+        List<ScalarOperator> conjuncts = Utils.extractConjuncts(scan.getPredicate());
+        boolean filterPushdown = props != null && props.isFilterPushdown()
+                && context.getSessionVariable().isFlightFilterPushdown();
+        if (!conjuncts.isEmpty() && !filterPushdown) {
+            return Collections.emptyList();
+        }
+        for (ScalarOperator conjunct : conjuncts) {
+            String p = FlightSqlRenderer.predicate(conjunct, cols);
+            if (p == null) {
+                return Collections.emptyList();
+            }
+            where.add(p);
+        }
+
+        // GROUP BY: scan columns passed through unchanged
+        Map<ColumnRefOperator, Column> newScanColumns = new LinkedHashMap<>();
+        List<String> groupBy = new ArrayList<>();
+        for (ColumnRefOperator key : agg.getGroupingKeys()) {
+            ScalarOperator resolved = resolver == null ? key : projection.get(key);
+            if (!key.equals(resolved) || !scanColumns.containsKey(key) || cols.remoteName(key) == null) {
+                return Collections.emptyList();
+            }
+            newScanColumns.put(key, scanColumns.get(key));
+            groupBy.add(scanColumns.get(key).getName());
+        }
+
+        Integer relationId = scanColumns.isEmpty() ? null :
+                factory.getRelationId(scanColumns.keySet().iterator().next().getId());
+        if (relationId == null) {
+            return Collections.emptyList();
+        }
+
+        Map<String, String> remoteAggregates = new LinkedHashMap<>();
+        Map<ColumnRefOperator, CallOperator> newAggregations = new HashMap<>();
+        // count outputs: count -> sum(partial) is nullable, and without GROUP BY it must be coalesced to 0;
+        // avg outputs: sum(partial sums) / sum(partial counts)
+        Map<ColumnRefOperator, ScalarOperator> replaced = new HashMap<>();
+        boolean hasGroupBy = !agg.getGroupingKeys().isEmpty();
+        Partials partials = new Partials(table, factory, relationId, cols,
+                props != null && "complete".equals(props.getResultMode()), newScanColumns, remoteAggregates);
+        for (Map.Entry<ColumnRefOperator, CallOperator> e : agg.getAggregations().entrySet()) {
+            CallOperator call = e.getValue();
+            String fn = call.getFnName();
+            if (call.isDistinct() || !FUNCTIONS.contains(fn) || call.getArguments().size() > 1) {
+                return Collections.emptyList();
+            }
+            ScalarOperator arg = call.getArguments().isEmpty() ? null : call.getArguments().get(0);
+            if (arg != null && resolver != null) {
+                arg = resolver.rewrite(arg);
+            }
+            if (FunctionSet.AVG.equals(fn)) {
+                // avg(x) = sum(x) / count(x), both computed remotely as partial aggregates (q01: the filtered
+                // lineitem no longer streams into the BE)
+                CallOperator[] sumCount = avgAsSumCount(call);
+                if (arg == null || sumCount == null) {
+                    return Collections.emptyList();
+                }
+                CallOperator sumRollup = partials.add(sumCount[0], arg);
+                CallOperator countRollup = partials.add(sumCount[1], arg);
+                if (sumRollup == null || countRollup == null) {
+                    return Collections.emptyList();
+                }
+                ColumnRefOperator sumMerged = factory.create("avg_sum_" + e.getKey().getId(),
+                        sumRollup.getType(), true);
+                ColumnRefOperator countMerged = factory.create("avg_count_" + e.getKey().getId(),
+                        countRollup.getType(), true);
+                newAggregations.put(sumMerged, sumRollup);
+                newAggregations.put(countMerged, countRollup);
+                replaced.put(e.getKey(), AggregatePushDownUtils.createAvgBySumCount(call, sumMerged, countMerged));
+                continue;
+            }
+            CallOperator rollup = partials.add(call, arg);
+            if (rollup == null) {
+                return Collections.emptyList();
+            }
+            if (FunctionSet.COUNT.equals(fn)) {
+                ColumnRefOperator merged = factory.create("sum_" + partials.lastName, rollup.getType(), true);
+                newAggregations.put(merged, rollup);
+                replaced.put(e.getKey(), AggregateFunctionRollupUtils.genRollupProject(call, merged, hasGroupBy));
+            } else {
+                newAggregations.put(e.getKey(), rollup);
+            }
+        }
+        if (newScanColumns.isEmpty()) {
+            return Collections.emptyList();
+        }
+
+        Map<Column, ColumnRefOperator> newScanMeta = new HashMap<>();
+        newScanColumns.forEach((ref, column) -> newScanMeta.put(column, ref));
+        LogicalFlightScanOperator newScan =
+                new LogicalFlightScanOperator(table, newScanColumns, newScanMeta, scan.getLimit(), null);
+        newScan.setAggregationPushdown(new FlightAggregationPushdown(groupBy, remoteAggregates, where));
+        newScan.setTimeTravel(scan.getTimeTravel());
+
+        LogicalAggregationOperator.Builder builder = LogicalAggregationOperator.builder().withOperator(agg)
+                .setAggregations(newAggregations);
+        if (!replaced.isEmpty()) {
+            ReplaceColumnRefRewriter rewriter = new ReplaceColumnRefRewriter(replaced);
+            Map<ColumnRefOperator, ScalarOperator> outputs = new LinkedHashMap<>();
+            if (agg.getProjection() == null) {
+                agg.getGroupingKeys().forEach(k -> outputs.put(k, k));
+                agg.getAggregations().keySet().forEach(k -> outputs.put(k, rewriter.rewrite(k)));
+            } else {
+                agg.getProjection().getColumnRefMap().forEach((k, v) -> outputs.put(k, rewriter.rewrite(v)));
+            }
+            builder.setProjection(new Projection(outputs));
+            if (agg.getPredicate() != null) {
+                builder.setPredicate(rewriter.rewrite(agg.getPredicate()));
+            }
+        }
+        return Collections.singletonList(OptExpression.create(builder.build(), OptExpression.create(newScan)));
+    }
+
+    /**
+     * The sum and count calls of {@code avg(x)} with the types StarRocks gives them (sum of DECIMAL(p,s) is
+     * DECIMAL(38,s)), or null when the argument type has no such functions.
+     */
+    @VisibleForTesting
+    static CallOperator[] avgAsSumCount(CallOperator avg) {
+        if (avg.getFunction() == null || avg.getFunction().getArgs().length != 1) {
+            return null;
+        }
+        Type[] argTypes = avg.getFunction().getArgs();
+        if (!argTypes[0].isNumericType() && !argTypes[0].isDecimalOfAnyVersion()) {
+            return null;
+        }
+        Function sumFn;
+        try {
+            sumFn = ScalarOperatorUtil.findSumFn(argTypes);
+        } catch (IllegalStateException ex) {
+            return null;
+        }
+        Function countFn = ScalarOperatorUtil.findArithmeticFunction(argTypes, FunctionSet.COUNT);
+        if (sumFn == null || countFn == null) {
+            return null;
+        }
+        return new CallOperator[] {
+                new CallOperator(FunctionSet.SUM, sumFn.getReturnType(), avg.getArguments(), sumFn),
+                new CallOperator(FunctionSet.COUNT, IntegerType.BIGINT, avg.getArguments(), countFn)};
+    }
+
+    /** Adds remote partial aggregates as synthetic scan columns and returns the StarRocks merge aggregate. */
+    private static final class Partials {
+        private final FlightTable table;
+        private final ColumnRefFactory factory;
+        private final int relationId;
+        private final FlightSqlRenderer.Columns cols;
+        private final boolean completeMode;
+        private final Map<ColumnRefOperator, Column> scanColumns;
+        private final Map<String, String> remoteAggregates;
+        private String lastName;
+
+        Partials(FlightTable table, ColumnRefFactory factory, int relationId, FlightSqlRenderer.Columns cols,
+                 boolean completeMode, Map<ColumnRefOperator, Column> scanColumns,
+                 Map<String, String> remoteAggregates) {
+            this.table = table;
+            this.factory = factory;
+            this.relationId = relationId;
+            this.cols = cols;
+            this.completeMode = completeMode;
+            this.scanColumns = scanColumns;
+            this.remoteAggregates = remoteAggregates;
+        }
+
+        /** {@code call} is count/sum/min/max, {@code arg} its argument in scan columns (null for count(*)). */
+        CallOperator add(CallOperator call, ScalarOperator arg) {
+            String fn = call.getFnName();
+            String remote = renderAggregate(fn, arg, call.getType(), cols, completeMode);
+            if (remote == null) {
+                return null;
+            }
+            String name = FlightAggregationPushdown.SYNTHETIC_PREFIX + remoteAggregates.size();
+            Type type = FunctionSet.COUNT.equals(fn) ? IntegerType.BIGINT : call.getType();
+            Column column = new Column(name, type, true);
+            ColumnRefOperator partial = factory.create(name, type, true);
+            factory.updateColumnToRelationIds(partial.getId(), relationId);
+            factory.updateColumnRefToColumns(partial, column, table);
+            scanColumns.put(partial, column);
+            remoteAggregates.put(name, remote);
+            lastName = name;
+            return AggregateFunctionRollupUtils.getRollupAggregateFunc(call, partial, false);
+        }
+    }
+
+    /** Remote partial aggregate whose result has the StarRocks type of the partial column, or null. */
+    @VisibleForTesting
+    static String renderAggregate(String fn, ScalarOperator arg, Type resultType,
+                                  FlightSqlRenderer.Columns cols, boolean completeMode) {
+        if (FunctionSet.COUNT.equals(fn)) {
+            if (arg != null && arg.isConstantNull()) {
+                // count(NULL) is 0; rare, left to StarRocks
+                return null;
+            }
+            if (arg == null || arg instanceof ConstantOperator) {
+                return "count(*)";
+            }
+            String in = FlightSqlRenderer.aggregateInput(arg, cols);
+            return in == null ? null : "count(" + in + ")";
+        }
+        if (arg == null) {
+            return null;
+        }
+        String in = FlightSqlRenderer.aggregateInput(arg, cols);
+        if (in == null) {
+            return null;
+        }
+        String sqlType = FlightSqlRenderer.numericSqlType(resultType);
+        if (FunctionSet.SUM.equals(fn)) {
+            if (sqlType == null) {
+                return null;
+            }
+            if (resultType.isDecimalOfAnyVersion() || resultType.isFloatingPointType()) {
+                // sum(DECIMAL(38,s)) is DECIMAL(38,s) and sum(DOUBLE) is DOUBLE on the server
+                return "sum(CAST(" + in + " AS " + sqlType + "))";
+            }
+            // the server sums integers as HUGEINT: only a cast around the sum gives the StarRocks type
+            return completeMode ? "CAST(sum(" + in + ") AS " + sqlType + ")" : null;
+        }
+        if (arg instanceof ColumnRefOperator) {
+            return fn + "(" + in + ")";
+        }
+        // min/max keep their argument's type
+        return sqlType == null ? null : fn + "(CAST(" + in + " AS " + sqlType + "))";
+    }
+}
