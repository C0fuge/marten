+/**
+ * Scan of an Arrow Flight SQL table. Planning renders one remote SQL query (projection, the translatable
+ * conjuncts, LIMIT, an optional partial aggregation), runs one GetFlightInfo, and turns every returned
+ * endpoint into one scan range, assigned round-robin over the alive BEs/CNs (the Kudu pattern). All
+ * conjuncts are still evaluated by the BE. Tickets and credentials never appear in EXPLAIN or logs.
+ */
+public class FlightScanNode extends ScanNode {
+    private final FlightTable table;
+    private final List<TScanRangeLocations> scanRanges = new ArrayList<>();
+    private FlightProperties props;
+    private String remoteSql;
+    private String defaultLocation;
+    private int endpointCount;
+    private long totalRecords = -1;
+    private int pushedConjuncts;
+    private int totalConjuncts;
+    private boolean limitPushed;
+
+    public FlightScanNode(PlanNodeId id, TupleDescriptor desc, String planNodeName) {
+        super(id, desc, planNodeName);
+        this.table = (FlightTable) desc.getTable();
+    }
+
+    private static boolean sessionFilterPushdown() {
+        ConnectContext ctx = ConnectContext.get();
+        return ctx == null || ctx.getSessionVariable().isFlightFilterPushdown();
+    }
+
+    private FlightMetadata metadata() {
+        FlightMetadata metadata = FlightConnector.metadataOf(table.getCatalogName());
+        if (metadata == null) {
+            // the connector is created lazily; getting it through the manager initializes it
+            GlobalStateMgr.getCurrentState().getConnectorMgr().getConnector(table.getCatalogName()).getMetadata();
+            metadata = FlightConnector.metadataOf(table.getCatalogName());
+        }
+        if (metadata == null) {
+            throw new StarRocksConnectorException("Flight catalog %s is not initialized", table.getCatalogName());
+        }
+        return metadata;
+    }
+
+    /**
+     * Renders the remote SQL for the slots of this scan.
+     *
+     * @param columnRefs   the scan's column refs to their table columns (to name pushed conjuncts)
+     * @param predicate    the scan predicate (every conjunct is also evaluated by the BE)
+     * @param limit        scan limit, or -1
+     * @param aggregation  partial aggregation computed by the server, or null
+     */
+    @VisibleForTesting
+    String renderRemoteSql(FlightProperties props, Map<ColumnRefOperator, Column> columnRefs, ScalarOperator predicate,
+                           long limit, FlightAggregationPushdown aggregation) {
+        List<FlightSqlRenderer.SelectItem> items = new ArrayList<>();
+        for (SlotDescriptor slot : desc.getSlots()) {
+            String name = slot.getColumn().getName();
+            if (aggregation != null && FlightAggregationPushdown.isSynthetic(name)) {
+                String agg = aggregation.getAggregates().get(name);
+                if (agg == null) {
+                    throw new StarRocksConnectorException("Unknown pushed aggregate column %s", name);
+                }
+                items.add(new FlightSqlRenderer.SelectItem(agg, name));
+            } else {
+                items.add(new FlightSqlRenderer.SelectItem(FlightSqlRenderer.quoteIdent(name), null));
+            }
+        }
+        List<String> where = new ArrayList<>();
+        List<String> groupBy = Collections.emptyList();
+        List<ScalarOperator> conjuncts = Utils.extractConjuncts(predicate);
+        totalConjuncts = conjuncts.size();
+        if (aggregation != null) {
+            // the aggregation rule only fires when every conjunct is rendered; they are part of it
+            where.addAll(aggregation.getWhere());
+            groupBy = aggregation.getGroupBy();
+            pushedConjuncts = totalConjuncts;
+        } else if (props.isFilterPushdown() && sessionFilterPushdown() && !conjuncts.isEmpty()) {
+            Map<ColumnRefOperator, String> pushable = new HashMap<>();
+            for (Map.Entry<ColumnRefOperator, Column> e : columnRefs.entrySet()) {
+                if (table.isFilterable(e.getValue().getName())) {
+                    pushable.put(e.getKey(), e.getValue().getName());
+                }
+            }
+            FlightSqlRenderer.Columns cols = FlightSqlRenderer.columns(pushable);
+            for (ScalarOperator conjunct : conjuncts) {
+                String p = FlightSqlRenderer.predicate(conjunct, cols);
+                if (p != null) {
+                    where.add(p);
+                }
+            }
+            pushedConjuncts = where.size();
+        }
+        // a LIMIT is exact only if the server applies every conjunct
+        long remoteLimit = -1;
+        if (aggregation == null && limit >= 0 && props.isLimitPushdown() && pushedConjuncts == totalConjuncts) {
+            remoteLimit = limit;
+        }
+        limitPushed = remoteLimit >= 0;
+        return FlightSqlRenderer.select(table.getCatalogDBName(), table.getCatalogTableName(), items, where, groupBy,
+                remoteLimit, false);
+    }
+
+    public void setupScanRangeLocations(Map<ColumnRefOperator, Column> columnRefs, ScalarOperator predicate,
+                                        long limit, FlightAggregationPushdown aggregation) {
+        FlightMetadata metadata = metadata();
+        props = metadata.getProperties();
+        remoteSql = renderRemoteSql(props, columnRefs, predicate, limit, aggregation);
+        List<RemoteFileInfo> files = GlobalStateMgr.getCurrentState().getMetadataMgr()
+                .getRemoteFiles(table, new FlightGetRemoteFilesParams(remoteSql));
+        FlightRemoteFileDesc fileDesc = (FlightRemoteFileDesc) files.get(0).getFiles().get(0);
+        defaultLocation = fileDesc.getDefaultLocation();
+        totalRecords = fileDesc.getTotalRecords();
+        List<FlightRemoteFileDesc.Endpoint> endpoints = fileDesc.getEndpoints();
+        endpointCount = endpoints.size();
+        if (endpoints.isEmpty()) {
+            return;
+        }
+        List<Long> nodeIds = getAllAvailableBackendOrComputeIds();
+        if (nodeIds.isEmpty()) {
+            throw new StarRocksConnectorException("No alive backend or compute node for the Flight scan");
+        }
+        long perEndpoint = totalRecords >= 0 ? (totalRecords + endpoints.size() - 1) / endpoints.size() : -1;
+        for (int i = 0; i < endpoints.size(); i++) {
+            FlightRemoteFileDesc.Endpoint e = endpoints.get(i);
+            TFlightScanRange range = new TFlightScanRange();
+            range.setTicket(e.ticket);
+            range.setLocations(new ArrayList<>(e.locations));
+            range.setEndpoint_index(i);
+            range.setEstimated_rows(perEndpoint);
+            TScanRange scanRange = new TScanRange();
+            scanRange.setFlight_scan_range(range);
+
+            TScanRangeLocations locations = new TScanRangeLocations();
+            locations.setScan_range(scanRange);
+            TScanRangeLocation location = new TScanRangeLocation();
+            location.setBackend_id(nodeIds.get(i % nodeIds.size()));
+            locations.addToLocations(location);
+            scanRanges.add(locations);
+        }
+    }
+
+    @VisibleForTesting
+    public List<Long> getAllAvailableBackendOrComputeIds() {
+        if (RunMode.isSharedDataMode()) {
+            ComputeResource computeResource = WarehouseManager.DEFAULT_RESOURCE;
+            if (ConnectContext.get() != null) {
+                computeResource = ConnectContext.get().getCurrentComputeResource();
+            }
+            return GlobalStateMgr.getCurrentState().getWarehouseMgr().getAliveComputeNodes(computeResource)
+                    .stream().map(ComputeNode::getId).collect(Collectors.toList());
+        }
+        SystemInfoService systemInfoService = GlobalStateMgr.getCurrentState().getNodeMgr().getClusterInfo();
+        List<Long> nodes = new ArrayList<>(systemInfoService.getAvailableBackendIds());
+        nodes.addAll(systemInfoService.getAvailableComputeNodeIds());
+        return nodes;
+    }
+
+    public String getRemoteSql() {
+        return remoteSql;
+    }
+
+    @Override
+    public List<TScanRangeLocations> getScanRangeLocations(long maxScanRangeLength) {
+        return scanRanges;
+    }
+
+    @Override
+    public void finalizeStats() {
+    }
+
+    @Override
+    protected String debugString() {
+        return MoreObjects.toStringHelper(this).addValue(super.debugString())
+                .addValue("flightTable=" + table.getName()).toString();
+    }
+
+    @Override
+    protected String getNodeExplainString(String prefix, TExplainLevel detailLevel) {
+        StringBuilder output = new StringBuilder();
+        output.append(prefix).append("TABLE: ").append(table.getCatalogDBName()).append(".")
+                .append(table.getCatalogTableName()).append("\n");
+        output.append(prefix).append("REMOTE SQL: ").append(remoteSql).append("\n");
+        output.append(prefix).append("ENDPOINTS: ").append(endpointCount);
+        if (totalRecords >= 0) {
+            output.append(", records=").append(totalRecords);
+        }
+        output.append("\n");
+        if (props != null) {
+            output.append(prefix).append("RESULT MODE: ").append(props.getResultMode()).append("\n");
+        }
+        output.append(prefix).append("PUSHED CONJUNCTS: ").append(pushedConjuncts).append("/").append(totalConjuncts);
+        if (limitPushed) {
+            output.append(", limit pushed");
+        }
+        output.append("\n");
+        if (!conjuncts.isEmpty()) {
+            output.append(prefix).append("PREDICATES: ").append(getExplainString(conjuncts)).append("\n");
+        }
+        if (detailLevel != TExplainLevel.VERBOSE) {
+            output.append(prefix).append(String.format("cardinality=%s", cardinality)).append("\n");
+        }
+        output.append(prefix).append(String.format("avgRowSize=%s", avgRowSize)).append("\n");
+        return output.toString();
+    }
+
+    @Override
+    protected void toThrift(TPlanNode msg) {
+        msg.node_type = TPlanNodeType.FLIGHT_SCAN_NODE;
+        TFlightScanNode node = new TFlightScanNode();
+        node.setTuple_id(desc.getId().asInt());
+        List<String> fieldNames = new ArrayList<>();
+        List<Integer> slotIds = new ArrayList<>();
+        for (SlotDescriptor slot : desc.getSlots()) {
+            fieldNames.add(slot.getColumn().getName());
+            slotIds.add(slot.getId().asInt());
+        }
+        node.setField_names(fieldNames);
+        node.setSlot_ids(slotIds);
+        node.setCatalog_name(table.getCatalogName());
+        node.setRemote_sql(remoteSql);
+        if (props != null) {
+            node.setDefault_location(defaultLocation != null ? defaultLocation : props.getDefaultLocation());
+            if (props.getToken() != null) {
+                node.setBearer_token(props.getToken());
+            }
+            if (props.getUser() != null) {
+                node.setUser(props.getUser());
+                node.setPassword(props.getPassword() == null ? "" : props.getPassword());
+            }
+            node.setTls_verify(props.isTlsVerify());
+            if (props.getTlsRootCerts() != null) {
+                node.setTls_root_certs(props.getTlsRootCerts());
+            }
+            if (props.getTlsOverrideHostname() != null) {
+                node.setTls_override_hostname(props.getTlsOverrideHostname());
+            }
+            node.setCall_headers(new HashMap<>(props.getCallHeaders()));
+            node.setConnect_timeout_ms(props.getConnectTimeoutMs());
+            node.setKeepalive_ms(props.getKeepaliveMs());
+            node.setRpc_timeout_ms(props.getRpcTimeoutMs());
+            node.setLocation_failover(props.isLocationFailover());
+        }
+        msg.flight_scan_node = node;
+        setConnectorCatalogType(msg);
+    }
+
+    @Override
+    public boolean canUseRuntimeAdaptiveDop() {
+        return true;
+    }
+}
