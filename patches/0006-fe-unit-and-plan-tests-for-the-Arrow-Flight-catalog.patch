+    @Test
+    public void testSmallTableIsBuildSide() throws Exception {
+        // both join orders: only real row counts make t1 the (broadcast) build side
+        for (String sql : new String[] {
+                "select count(*) from " + T1 + " a join " + T2 + " b on a.id = b.id",
+                "select count(*) from " + T2 + " b join " + T1 + " a on a.id = b.id"}) {
+            String plan = getFragmentPlan(sql);
+            String joinFragment = null;
+            for (String fragment : plan.split("PLAN FRAGMENT")) {
+                if (fragment.contains("HASH JOIN")) {
+                    joinFragment = fragment;
+                }
+            }
+            Assertions.assertNotNull(joinFragment, plan);
+            // the probe side (t2) is scanned in the join's fragment, t1 arrives through the build-side exchange
+            assertContains(joinFragment, "TABLE: s1.t2", "BROADCAST");
+            assertNotContains(joinFragment, "TABLE: s1.t1");
+        }
+    }
