+package com.starrocks.connector.flight;
+
+import com.starrocks.type.ArrayType;
+import com.starrocks.type.MapType;
+import com.starrocks.type.PrimitiveType;
+import com.starrocks.type.ScalarType;
+import com.starrocks.type.StructType;
+import com.starrocks.type.Type;
+import org.apache.arrow.vector.types.DateUnit;
+import org.apache.arrow.vector.types.FloatingPointPrecision;
+import org.apache.arrow.vector.types.TimeUnit;
+import org.apache.arrow.vector.types.pojo.ArrowType;
+import org.apache.arrow.vector.types.pojo.Field;
+import org.apache.arrow.vector.types.pojo.FieldType;
+import org.junit.jupiter.api.Assertions;
+import org.junit.jupiter.api.Test;
+
+import java.util.Arrays;
+import java.util.Collections;
+
+public class FlightTypeMapperTest {
+    private static Field field(String name, ArrowType type, Field... children) {
+        return new Field(name, FieldType.nullable(type), Arrays.asList(children));
+    }
+
+    private static Type map(ArrowType type) {
+        return FlightTypeMapper.toStarRocksType(field("c", type), FlightProperties.NestedTypes.NATIVE);
+    }
+
+    @Test
+    public void testScalarTypes() {
+        Assertions.assertEquals(PrimitiveType.BOOLEAN, map(ArrowType.Bool.INSTANCE).getPrimitiveType());
+        Assertions.assertEquals(PrimitiveType.TINYINT, map(new ArrowType.Int(8, true)).getPrimitiveType());
+        Assertions.assertEquals(PrimitiveType.SMALLINT, map(new ArrowType.Int(16, true)).getPrimitiveType());
+        Assertions.assertEquals(PrimitiveType.INT, map(new ArrowType.Int(32, true)).getPrimitiveType());
+        Assertions.assertEquals(PrimitiveType.BIGINT, map(new ArrowType.Int(64, true)).getPrimitiveType());
+        Assertions.assertEquals(PrimitiveType.FLOAT,
+                map(new ArrowType.FloatingPoint(FloatingPointPrecision.SINGLE)).getPrimitiveType());
+        Assertions.assertEquals(PrimitiveType.DOUBLE,
+                map(new ArrowType.FloatingPoint(FloatingPointPrecision.DOUBLE)).getPrimitiveType());
+        Assertions.assertEquals(PrimitiveType.VARCHAR, map(ArrowType.Utf8.INSTANCE).getPrimitiveType());
+        Assertions.assertEquals(PrimitiveType.VARCHAR, map(ArrowType.LargeUtf8.INSTANCE).getPrimitiveType());
+        Assertions.assertEquals(PrimitiveType.VARBINARY, map(ArrowType.Binary.INSTANCE).getPrimitiveType());
+        Assertions.assertEquals(PrimitiveType.DATE, map(new ArrowType.Date(DateUnit.DAY)).getPrimitiveType());
+        Assertions.assertEquals(PrimitiveType.DATETIME,
+                map(new ArrowType.Timestamp(TimeUnit.MICROSECOND, null)).getPrimitiveType());
+        Assertions.assertEquals(PrimitiveType.DATETIME,
+                map(new ArrowType.Timestamp(TimeUnit.NANOSECOND, "UTC")).getPrimitiveType());
+    }
+
+    @Test
+    public void testUnsignedIntegersAreWidened() {
+        Assertions.assertEquals(PrimitiveType.SMALLINT, map(new ArrowType.Int(8, false)).getPrimitiveType());
+        Assertions.assertEquals(PrimitiveType.INT, map(new ArrowType.Int(16, false)).getPrimitiveType());
+        Assertions.assertEquals(PrimitiveType.BIGINT, map(new ArrowType.Int(32, false)).getPrimitiveType());
+        Assertions.assertEquals(PrimitiveType.LARGEINT, map(new ArrowType.Int(64, false)).getPrimitiveType());
+    }
+
+    @Test
+    public void testDecimal() {
+        Type t = map(new ArrowType.Decimal(15, 2, 128));
+        Assertions.assertTrue(t.isDecimalOfAnyVersion());
+        Assertions.assertEquals(15, ((ScalarType) t).getScalarPrecision());
+        Assertions.assertEquals(2, ((ScalarType) t).getScalarScale());
+        Assertions.assertTrue(map(new ArrowType.Decimal(38, 10, 128)).isDecimalOfAnyVersion());
+        // Decimal256 has no BE converter
+        Assertions.assertNull(map(new ArrowType.Decimal(40, 2, 256)));
+        Assertions.assertNull(map(new ArrowType.Decimal(20, 2, 256)));
+    }
+
+    @Test
+    public void testUnsupportedTypesAreHidden() {
+        Assertions.assertNull(map(new ArrowType.Time(TimeUnit.MICROSECOND, 64)));
+        Assertions.assertNull(map(new ArrowType.Duration(TimeUnit.SECOND)));
+        Assertions.assertNull(map(ArrowType.Null.INSTANCE));
+    }
+
+    @Test
+    public void testNestedTypes() {
+        Field list = field("l", ArrowType.List.INSTANCE, field("item", new ArrowType.Int(32, true)));
+        Type nativeType = FlightTypeMapper.toStarRocksType(list, FlightProperties.NestedTypes.NATIVE);
+        Assertions.assertTrue(nativeType instanceof ArrayType);
+        Assertions.assertEquals(PrimitiveType.INT, ((ArrayType) nativeType).getItemType().getPrimitiveType());
+        Assertions.assertNull(FlightTypeMapper.toStarRocksType(list, FlightProperties.NestedTypes.HIDE));
+        Assertions.assertEquals(PrimitiveType.JSON,
+                FlightTypeMapper.toStarRocksType(list, FlightProperties.NestedTypes.JSON).getPrimitiveType());
+
+        Field entries = new Field("entries", FieldType.notNullable(ArrowType.Struct.INSTANCE), Arrays.asList(
+                new Field("key", FieldType.notNullable(ArrowType.Utf8.INSTANCE), Collections.emptyList()),
+                field("value", new ArrowType.Int(64, true))));
+        Field mapField = field("m", new ArrowType.Map(false), entries);
+        Assertions.assertTrue(FlightTypeMapper.toStarRocksType(mapField, FlightProperties.NestedTypes.NATIVE)
+                instanceof MapType);
+
+        Field struct = field("s", ArrowType.Struct.INSTANCE, field("a", ArrowType.Utf8.INSTANCE),
+                field("b", new ArrowType.Date(DateUnit.DAY)));
+        Assertions.assertTrue(FlightTypeMapper.toStarRocksType(struct, FlightProperties.NestedTypes.NATIVE)
+                instanceof StructType);
+        // a struct with an unsupported child is hidden as a whole
+        Field badStruct = field("s", ArrowType.Struct.INSTANCE, field("t", new ArrowType.Time(TimeUnit.SECOND, 32)));
+        Assertions.assertNull(FlightTypeMapper.toStarRocksType(badStruct, FlightProperties.NestedTypes.NATIVE));
+    }
+}
diff --git a/fe/fe-core/src/test/java/com/starrocks/connector/flight/MockedFlightSqlMetadataClient.java b/fe/fe-core/src/test/java/com/starrocks/connector/flight/MockedFlightSqlMetadataClient.java
new file mode 100644
