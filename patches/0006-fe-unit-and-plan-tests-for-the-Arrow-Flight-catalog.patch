+package com.starrocks.connector.flight;
+
+import com.google.common.collect.ImmutableList;
+import com.google.common.collect.ImmutableMap;
+import com.starrocks.sql.ast.expression.BinaryType;
+import com.starrocks.sql.optimizer.operator.scalar.BinaryPredicateOperator;
+import com.starrocks.sql.optimizer.operator.scalar.ColumnRefOperator;
+import com.starrocks.sql.optimizer.operator.scalar.CompoundPredicateOperator;
+import com.starrocks.sql.optimizer.operator.scalar.ConstantOperator;
+import com.starrocks.sql.optimizer.operator.scalar.InPredicateOperator;
+import com.starrocks.sql.optimizer.operator.scalar.IsNullPredicateOperator;
+import com.starrocks.sql.optimizer.operator.scalar.LikePredicateOperator;
+import com.starrocks.type.FloatType;
+import com.starrocks.type.IntegerType;
+import com.starrocks.type.TypeFactory;
+import com.starrocks.type.VarcharType;
+import org.junit.jupiter.api.Assertions;
+import org.junit.jupiter.api.Test;
+
+import java.math.BigDecimal;
+import java.time.LocalDateTime;
+import java.util.Collections;
+
+public class FlightSqlRendererTest {
+    private final ColumnRefOperator id = new ColumnRefOperator(1, IntegerType.INT, "id", true);
+    private final ColumnRefOperator name = new ColumnRefOperator(2, VarcharType.VARCHAR, "name", true);
+    private final ColumnRefOperator price = new ColumnRefOperator(3, FloatType.FLOAT, "price", true);
+    private final ColumnRefOperator hidden = new ColumnRefOperator(4, IntegerType.INT, "hidden", true);
+    private final FlightSqlRenderer.Columns cols = FlightSqlRenderer.columns(
+            ImmutableMap.of(id, "id", name, "Na\"me", price, "price"));
+
+    @Test
+    public void testQuoting() {
+        Assertions.assertEquals("\"a\"\"b\"", FlightSqlRenderer.quoteIdent("a\"b"));
+        Assertions.assertEquals("\"s\".\"t\"", FlightSqlRenderer.tableRef("s", "t"));
+        Assertions.assertEquals("'it''s'", FlightSqlRenderer.stringLiteral("it's"));
+    }
+
+    @Test
+    public void testLiterals() {
+        Assertions.assertEquals("42", FlightSqlRenderer.literal(ConstantOperator.createInt(42)));
+        Assertions.assertEquals("-7", FlightSqlRenderer.literal(ConstantOperator.createBigint(-7)));
+        Assertions.assertEquals("'a''b'", FlightSqlRenderer.literal(ConstantOperator.createVarchar("a'b")));
+        Assertions.assertEquals("12.50", FlightSqlRenderer.literal(ConstantOperator.createDecimal(
+                new BigDecimal("12.50"), TypeFactory.createUnifiedDecimalType(10, 2))));
+        Assertions.assertEquals("DATE '2024-02-29'",
+                FlightSqlRenderer.literal(ConstantOperator.createDate(LocalDateTime.of(2024, 2, 29, 0, 0))));
+        Assertions.assertEquals("TIMESTAMP '2024-02-29 13:14:15.000001'", FlightSqlRenderer.literal(
+                ConstantOperator.createDatetime(LocalDateTime.of(2024, 2, 29, 13, 14, 15, 1000))));
+        Assertions.assertEquals("NULL", FlightSqlRenderer.literal(ConstantOperator.createNull(IntegerType.INT)));
+    }
+
+    @Test
+    public void testPredicates() {
+        Assertions.assertEquals("(\"id\" = 5)", FlightSqlRenderer.predicate(
+                new BinaryPredicateOperator(BinaryType.EQ, id, ConstantOperator.createInt(5)), cols));
+        Assertions.assertEquals("(\"id\" <> 5)", FlightSqlRenderer.predicate(
+                new BinaryPredicateOperator(BinaryType.NE, id, ConstantOperator.createInt(5)), cols));
+        Assertions.assertEquals("(\"Na\"\"me\" LIKE 'ab%')", FlightSqlRenderer.predicate(
+                new LikePredicateOperator(name, ConstantOperator.createVarchar("ab%")), cols));
+        Assertions.assertEquals("(\"id\" IN (1, 2))", FlightSqlRenderer.predicate(
+                new InPredicateOperator(false, id, ConstantOperator.createInt(1), ConstantOperator.createInt(2)),
+                cols));
+        Assertions.assertEquals("(\"id\" IS NULL)", FlightSqlRenderer.predicate(
+                new IsNullPredicateOperator(false, id), cols));
+        Assertions.assertEquals("((\"id\" > 1) OR (\"Na\"\"me\" = 'x'))", FlightSqlRenderer.predicate(
+                new CompoundPredicateOperator(CompoundPredicateOperator.CompoundType.OR,
+                        new BinaryPredicateOperator(BinaryType.GT, id, ConstantOperator.createInt(1)),
+                        new BinaryPredicateOperator(BinaryType.EQ, name, ConstantOperator.createVarchar("x"))),
+                cols));
+    }
+
+    @Test
+    public void testNotRenderable() {
+        // FLOAT comparisons differ between engines
+        Assertions.assertNull(FlightSqlRenderer.predicate(new BinaryPredicateOperator(BinaryType.LT, price,
+                ConstantOperator.createFloat(1.5)), cols));
+        // column without an exact remote representation
+        Assertions.assertNull(FlightSqlRenderer.predicate(
+                new BinaryPredicateOperator(BinaryType.EQ, hidden, ConstantOperator.createInt(1)), cols));
+        // backslash escapes differ
+        Assertions.assertNull(FlightSqlRenderer.predicate(
+                new LikePredicateOperator(name, ConstantOperator.createVarchar("a\\%")), cols));
+        // one part of an OR that cannot be rendered makes the whole OR StarRocks-only
+        Assertions.assertNull(FlightSqlRenderer.predicate(
+                new CompoundPredicateOperator(CompoundPredicateOperator.CompoundType.OR,
+                        new BinaryPredicateOperator(BinaryType.GT, id, ConstantOperator.createInt(1)),
+                        new BinaryPredicateOperator(BinaryType.EQ, hidden, ConstantOperator.createInt(1))),
+                cols));
+        // string compared with a number
+        Assertions.assertNull(FlightSqlRenderer.predicate(
+                new BinaryPredicateOperator(BinaryType.EQ, name, ConstantOperator.createInt(1)), cols));
+    }
+
+    @Test
+    public void testSelect() {
+        Assertions.assertEquals("SELECT \"a\", \"b\" FROM \"s\".\"t\" WHERE (\"a\" = 1) AND (\"b\" IS NULL) LIMIT 10",
+                FlightSqlRenderer.select("s", "t", ImmutableList.of(
+                                new FlightSqlRenderer.SelectItem("\"a\"", null),
+                                new FlightSqlRenderer.SelectItem("\"b\"", null)),
+                        ImmutableList.of("(\"a\" = 1)", "(\"b\" IS NULL)"), Collections.emptyList(), 10, false));
+        Assertions.assertEquals("SELECT 1 FROM \"s\".\"t\"", FlightSqlRenderer.select("s", "t",
+                Collections.emptyList(), Collections.emptyList(), Collections.emptyList(), -1, false));
+        Assertions.assertEquals("SELECT \"g\", sum(\"x\") AS \"__flight_agg_0\" FROM \"s\".\"t\" GROUP BY \"g\"",
+                FlightSqlRenderer.select("s", "t", ImmutableList.of(
+                                new FlightSqlRenderer.SelectItem("\"g\"", null),
+                                new FlightSqlRenderer.SelectItem("sum(\"x\")", "__flight_agg_0")),
+                        Collections.emptyList(), ImmutableList.of("g"), -1, false));
+    }
+}
