+    @Test
+    public void testTimeTravelIsForwarded() throws Exception {
+        String plan = getFragmentPlan("select id from " + T1 + " for version as of 42 where id > 1");
+        assertContains(remoteSql(plan), " FROM \"s1\".\"t1\" FOR VERSION AS OF 42 WHERE (\"id\" > 1)");
+
+        // a pushed aggregation keeps the clause
+        plan = getFragmentPlan("select k, count(*) from " + T1 + " for version as of 7 group by k");
+        assertContains(remoteSql(plan), "FROM \"s1\".\"t1\" FOR VERSION AS OF 7 GROUP BY \"k\"");
+
+        // the session time zone is applied and the server gets UTC
+        String tz = connectContext.getSessionVariable().getTimeZone();
+        try {
+            connectContext.getSessionVariable().setTimeZone("Asia/Shanghai");
+            plan = getFragmentPlan("select id from " + T1 + " for timestamp as of '2026-10-25 12:00:00'");
+            assertContains(remoteSql(plan),
+                    "FROM \"s1\".\"t1\" FOR TIMESTAMP AS OF TIMESTAMP '2026-10-25 04:00:00 UTC'");
+        } finally {
+            connectContext.getSessionVariable().setTimeZone(tz);
+        }
+
+        // the same table at two versions stays two scans
+        plan = getFragmentPlan("select a.id from " + T1 + " for version as of 1 as a join " + T1
+                + " for version as of 2 as b on a.id = b.id");
+        assertContains(plan, "FOR VERSION AS OF 1", "FOR VERSION AS OF 2");
+    }
