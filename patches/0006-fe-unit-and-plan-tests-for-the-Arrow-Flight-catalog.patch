+    @Test
+    public void testColumnRanges() {
+        FlightProperties props = new FlightProperties(Map.of("type", "flight",
+                FlightProperties.URI, MockedFlightSqlMetadataClient.LOCATION));
+        MockedFlightSqlMetadataClient client = new MockedFlightSqlMetadataClient(props);
+        FlightMetadata metadata = new FlightMetadata(CATALOG, props, client);
+        FlightTable t2 = (FlightTable) metadata.getTable(connectContext, "s1", "t2");
+        // min of the endpoints' minima, max of their maxima; k (VARCHAR) and price (FLOAT) get no range
+        Map<String, double[]> ranges = metadata.getColumnRanges(t2);
+        Assertions.assertEquals(List.of("id"), List.copyOf(ranges.keySet()));
+        Assertions.assertArrayEquals(new double[] {1, MockedFlightSqlMetadataClient.BIG_ROW_COUNT}, ranges.get("id"));
+        Assertions.assertEquals(List.of("SELECT min(\"id\"), max(\"id\") FROM \"s1\".\"t2\""),
+                client.getStatsQueries());
+        // t1: the second endpoint returns NULLs
+        FlightTable t1 = (FlightTable) metadata.getTable(connectContext, "s1", "t1");
+        Assertions.assertArrayEquals(new double[] {1, MockedFlightSqlMetadataClient.ROW_COUNT},
+                metadata.getColumnRanges(t1).get("id"));
+        // cached
+        metadata.clear();
+        metadata.getColumnRanges(t2);
+        Assertions.assertEquals(2, client.getStatsQueries().size());
+    }
