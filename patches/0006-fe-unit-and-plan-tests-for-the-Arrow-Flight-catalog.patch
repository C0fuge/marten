+package com.starrocks.connector.flight;
+
+import com.starrocks.connector.exception.StarRocksConnectorException;
+import org.apache.arrow.flight.FlightServer;
+import org.apache.arrow.flight.Location;
+import org.apache.arrow.flight.NoOpFlightProducer;
+import org.apache.arrow.memory.BufferAllocator;
+import org.apache.arrow.memory.RootAllocator;
+import org.junit.jupiter.api.AfterEach;
+import org.junit.jupiter.api.Assertions;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+
+import java.net.InetAddress;
+import java.net.ServerSocket;
+import java.util.HashMap;
+import java.util.Map;
+
+/**
+ * Connect timeout and URI failover of the metadata client against an in-process Flight server that implements
+ * nothing (every call answers UNIMPLEMENTED, which proves the call reached it).
+ */
+public class FlightSqlMetadataClientTest {
+    private BufferAllocator allocator;
+    private FlightServer server;
+    private String serverUri;
+
+    @BeforeEach
+    public void setUp() throws Exception {
+        allocator = new RootAllocator(Long.MAX_VALUE);
+        server = FlightServer.builder(allocator, Location.forGrpcInsecure("127.0.0.1", 0), new NoOpFlightProducer())
+                .build().start();
+        serverUri = "grpc://127.0.0.1:" + server.getPort();
+    }
+
+    @AfterEach
+    public void tearDown() throws Exception {
+        server.close();
+        allocator.close();
+    }
+
+    private static FlightProperties props(String uris) {
+        Map<String, String> m = new HashMap<>();
+        m.put("type", "flight");
+        m.put(FlightProperties.URI, uris);
+        m.put(FlightProperties.CONNECT_TIMEOUT_MS, "1000");
+        m.put(FlightProperties.RPC_TIMEOUT_MS, "30000");
+        return new FlightProperties(m);
+    }
+
+    private static int closedPort() throws Exception {
+        try (ServerSocket s = new ServerSocket(0, 1, InetAddress.getLoopbackAddress())) {
+            return s.getLocalPort();
+        }
+    }
+
+    private void assertReachedServer(FlightSqlMetadataClient client) {
+        StarRocksConnectorException e = Assertions.assertThrows(StarRocksConnectorException.class,
+                client::listSchemas);
+        Assertions.assertTrue(e.getMessage().contains("UNIMPLEMENTED"), e.getMessage());
+        Assertions.assertEquals(serverUri, client.currentLocation());
+    }
+
+    @Test
+    public void testFailoverFromSilentUriWithinConnectTimeout() throws Exception {
+        // accepts TCP connects (kernel backlog) but never answers: without a connect timeout the first call
+        // would wait for its 30 s deadline
+        try (ServerSocket silent = new ServerSocket(0, 16, InetAddress.getLoopbackAddress());
+                FlightSqlMetadataClient client = new FlightSqlMetadataClient(
+                        props("grpc://127.0.0.1:" + silent.getLocalPort() + "," + serverUri))) {
+            long start = System.nanoTime();
+            assertReachedServer(client);
+            long elapsedMs = (System.nanoTime() - start) / 1_000_000;
+            Assertions.assertTrue(elapsedMs < 10_000, "failover took " + elapsedMs + " ms");
+        }
+    }
+
+    @Test
+    public void testFailoverFromRefusedUri() throws Exception {
+        try (FlightSqlMetadataClient client = new FlightSqlMetadataClient(
+                props("grpc://127.0.0.1:" + closedPort() + "," + serverUri))) {
+            assertReachedServer(client);
+        }
+    }
+
+    @Test
+    public void testServerErrorIsNotFailedOver() throws Exception {
+        // the reachable server answers first with an error: the second URI is never tried
+        try (FlightSqlMetadataClient client = new FlightSqlMetadataClient(
+                props(serverUri + ",grpc://127.0.0.1:" + closedPort()))) {
+            assertReachedServer(client);
+        }
+    }
+}
