+    @Test
+    public void testColumnRangeSelectivity() throws Exception {
+        // id of t2 spans 1..10M (min/max from the server), so id <= 1M keeps about a tenth of the rows; without
+        // column statistics the optimizer's default selectivity applies
+        String plan = getCostExplain("select id, k from " + T2 + " where id <= 1000000");
+        long card = flightScanCardinality(plan);
+        Assertions.assertTrue(card > 500_000 && card < 2_000_000, plan);
+        // a range outside the column's values
+        plan = getCostExplain("select id, k from " + T2 + " where id > 20000000");
+        Assertions.assertTrue(flightScanCardinality(plan) <= 1000, plan);
+    }
