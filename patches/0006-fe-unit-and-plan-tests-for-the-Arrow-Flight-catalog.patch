+package com.starrocks.sql.optimizer.rule.transformation;
+
+import com.google.common.collect.ImmutableMap;
+import com.starrocks.catalog.FunctionSet;
+import com.starrocks.connector.flight.FlightSqlRenderer;
+import com.starrocks.sql.optimizer.operator.scalar.ColumnRefOperator;
+import com.starrocks.sql.optimizer.operator.scalar.ConstantOperator;
+import com.starrocks.type.FloatType;
+import com.starrocks.type.IntegerType;
+import com.starrocks.type.Type;
+import com.starrocks.type.TypeFactory;
+import com.starrocks.type.VarcharType;
+import org.junit.jupiter.api.Assertions;
+import org.junit.jupiter.api.Test;
+
+public class FlightAggregationPushdownRuleTest {
+    private final ColumnRefOperator id = new ColumnRefOperator(1, IntegerType.INT, "id", true);
+    private final ColumnRefOperator name = new ColumnRefOperator(2, VarcharType.VARCHAR, "name", true);
+    private final ColumnRefOperator price = new ColumnRefOperator(3, FloatType.FLOAT, "price", true);
+    private final FlightSqlRenderer.Columns cols = FlightSqlRenderer.columns(ImmutableMap.of(id, "id", name, "name"));
+
+    private String render(String fn, ColumnRefOperator arg, Type type) {
+        return FlightAggregationPushdownRule.renderAggregate(fn, arg, type, cols, false);
+    }
+
+    @Test
+    public void testCount() {
+        Assertions.assertEquals("count(*)", render(FunctionSet.COUNT, null, IntegerType.BIGINT));
+        Assertions.assertEquals("count(*)", FlightAggregationPushdownRule.renderAggregate(FunctionSet.COUNT,
+                ConstantOperator.createInt(1), IntegerType.BIGINT, cols, false));
+        Assertions.assertNull(FlightAggregationPushdownRule.renderAggregate(FunctionSet.COUNT,
+                ConstantOperator.createNull(IntegerType.INT), IntegerType.BIGINT, cols, false));
+        Assertions.assertEquals("count(\"name\")", render(FunctionSet.COUNT, name, IntegerType.BIGINT));
+        // no exact remote column
+        Assertions.assertNull(render(FunctionSet.COUNT, price, IntegerType.BIGINT));
+    }
+
+    @Test
+    public void testSumIsCastToTheStarRocksType() {
+        // the cast goes inside the sum: result mode partial accepts only bare fn(expr) items
+        Assertions.assertEquals("sum(CAST(\"id\" AS DECIMAL(38,2)))",
+                render(FunctionSet.SUM, id, TypeFactory.createDecimalV3NarrowestType(38, 2)));
+        Assertions.assertEquals("sum(CAST(\"id\" AS DOUBLE))", render(FunctionSet.SUM, id, FloatType.DOUBLE));
+        // an integer sum is HUGEINT on the server: cast around it, so only in result mode complete
+        Assertions.assertNull(render(FunctionSet.SUM, id, IntegerType.BIGINT));
+        Assertions.assertEquals("CAST(sum(\"id\") AS BIGINT)", FlightAggregationPushdownRule.renderAggregate(
+                FunctionSet.SUM, id, IntegerType.BIGINT, cols, true));
+        // no SQL type for LARGEINT
+        Assertions.assertNull(render(FunctionSet.SUM, id, IntegerType.LARGEINT));
+        Assertions.assertNull(render(FunctionSet.SUM, null, IntegerType.BIGINT));
+    }
+
+    @Test
+    public void testMinMax() {
+        Assertions.assertEquals("min(\"name\")", render(FunctionSet.MIN, name, VarcharType.VARCHAR));
+        Assertions.assertEquals("max(\"id\")", render(FunctionSet.MAX, id, IntegerType.INT));
+        Assertions.assertNull(render(FunctionSet.MAX, price, FloatType.FLOAT));
+    }
+}
diff --git a/fe/fe-core/src/test/java/com/starrocks/sql/plan/FlightScanPlanTest.java b/fe/fe-core/src/test/java/com/starrocks/sql/plan/FlightScanPlanTest.java
new file mode 100644
index 00000000..6cac83e7
--- /dev/null
+++ b/fe/fe-core/src/test/java/com/starrocks/sql/plan/FlightScanPlanTest.java
@@ -0,0 +1,220 @@
+// Copyright 2021-present StarRocks, Inc. All rights reserved.
+//
+// Licensed under the Apache License, Version 2.0 (the "License");
+// you may not use this file except in compliance with the License.
+// You may obtain a copy of the License at
+//
+//     https://www.apache.org/licenses/LICENSE-2.0
