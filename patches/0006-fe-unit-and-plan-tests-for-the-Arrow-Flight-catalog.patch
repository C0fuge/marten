+package com.starrocks.sql.plan;
+
+import com.starrocks.connector.MockedMetadataMgr;
+import com.starrocks.catalog.FlightTable;
+import com.starrocks.connector.flight.FlightConnector;
+import com.starrocks.connector.flight.FlightMetadata;
+import com.starrocks.connector.flight.FlightProperties;
+import com.starrocks.connector.flight.MockedFlightSqlMetadataClient;
+import com.starrocks.server.GlobalStateMgr;
+import com.starrocks.sql.optimizer.Utils;
+import org.junit.jupiter.api.AfterAll;
+import org.junit.jupiter.api.Assertions;
+import org.junit.jupiter.api.BeforeAll;
+import org.junit.jupiter.api.Test;
+
+import java.math.BigDecimal;
+import java.math.BigInteger;
+import java.time.LocalDate;
+import java.time.LocalDateTime;
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.regex.Matcher;
+import java.util.regex.Pattern;
+
+/**
+ * Plans of Flight scans: the REMOTE SQL in EXPLAIN for projection, filters, LIMIT and aggregation pushdown; row-count
+ * statistics in the plan (t1: 1000 rows, t2: 10M rows; column {@code id} 1..row count); min/max values as optimizer
+ * doubles.
+ */
+public class FlightScanPlanTest extends PlanTestBase {
+    private static final String CATALOG = "flight0";
+    private static final String T1 = CATALOG + ".s1.t1";
+    private static final String T2 = CATALOG + ".s1.t2";
+
+    @BeforeAll
+    public static void beforeClass() throws Exception {
+        PlanTestBase.beforeClass();
+        GlobalStateMgr gsm = connectContext.getGlobalStateMgr();
+        MockedMetadataMgr metadataMgr = new MockedMetadataMgr(gsm.getLocalMetastore(), gsm.getConnectorMgr());
+        gsm.setMetadataMgr(metadataMgr);
+        Map<String, String> properties = new HashMap<>();
+        properties.put("type", "flight");
+        properties.put(FlightProperties.URI, MockedFlightSqlMetadataClient.LOCATION);
+        gsm.getCatalogMgr().createCatalog("flight", CATALOG, "", properties);
+        // the scan node and the aggregation rule read the catalog properties from the (lazily created) connector
+        gsm.getConnectorMgr().getConnector(CATALOG).getMetadata();
+        Assertions.assertNotNull(FlightConnector.metadataOf(CATALOG));
+        FlightProperties props = new FlightProperties(properties);
+        metadataMgr.registerMockedMetadata(CATALOG,
+                new FlightMetadata(CATALOG, props, new MockedFlightSqlMetadataClient(props)));
+    }
+
+    @AfterAll
+    public static void afterClass() {
+        ConnectorPlanTestBase.dropCatalog(CATALOG);
+    }
+
+    private static String remoteSql(String plan) {
+        for (String line : plan.split("\n")) {
+            int i = line.indexOf("REMOTE SQL: ");
+            if (i >= 0) {
+                return line.substring(i + "REMOTE SQL: ".length()).trim();
+            }
+        }
+        Assertions.fail("no REMOTE SQL in plan:\n" + plan);
+        return null;
+    }
+
+    @Test
+    public void testProjection() throws Exception {
+        String plan = getFragmentPlan("select k, id from " + T1);
+        String sql = remoteSql(plan);
+        Assertions.assertTrue(sql.startsWith("SELECT "), sql);
+        Assertions.assertTrue(sql.endsWith(" FROM \"s1\".\"t1\""), sql);
+        assertContains(sql, "\"id\"", "\"k\"");
+        assertNotContains(sql, "\"price\"");
+        assertContains(plan, "FlightScanNode", "TABLE: s1.t1", "ENDPOINTS: 2, records=1000", "RESULT MODE: partial",
+                "PUSHED CONJUNCTS: 0/0");
+    }
+
+    @Test
+    public void testFiltersArePushedAndRechecked() throws Exception {
+        String plan = getFragmentPlan("select id from " + T1 + " where id > 10 and k = 'a'");
+        String sql = remoteSql(plan);
+        assertContains(sql, " WHERE ", "(\"id\" > 10)", "(\"k\" = 'a')");
+        assertContains(plan, "PUSHED CONJUNCTS: 2/2", "PREDICATES: ");
+    }
+
+    @Test
+    public void testLimitPushedOnlyWithAllConjuncts() throws Exception {
+        String plan = getFragmentPlan("select id from " + T1 + " limit 5");
+        Assertions.assertTrue(remoteSql(plan).endsWith(" LIMIT 5"), plan);
+        assertContains(plan, "limit pushed");
+
+        plan = getFragmentPlan("select id from " + T1 + " where id = 3 limit 5");
+        assertContains(remoteSql(plan), "WHERE (\"id\" = 3) LIMIT 5");
+
+        // FLOAT columns are never filtered remotely, so the LIMIT must stay local
+        plan = getFragmentPlan("select id from " + T1 + " where price > 1.5 limit 5");
+        String sql = remoteSql(plan);
+        assertNotContains(sql, "WHERE", "LIMIT");
+        assertContains(plan, "PUSHED CONJUNCTS: 0/1");
+        assertNotContains(plan, "limit pushed");
+    }
+
+    @Test
+    public void testCountStar() throws Exception {
+        String plan = getFragmentPlan("select count(*) from " + T1);
+        Assertions.assertEquals("SELECT count(*) AS \"__flight_agg_0\" FROM \"s1\".\"t1\"", remoteSql(plan), plan);
+        // count without GROUP BY: sum of partial counts over no rows is NULL, so it is coalesced to 0
+        assertContains(plan, "coalesce(");
+        assertNotContains(plan, "PREDICATES: ");
+    }
+
+    @Test
+    public void testGroupByWithWhereAndHaving() throws Exception {
+        String plan = getFragmentPlan("select k, count(*), min(id), max(id) from " + T1
+                + " where id > 0 group by k having count(*) > 1");
+        String sql = remoteSql(plan);
+        assertContains(sql, "count(*) AS \"__flight_agg_", "min(\"id\") AS \"__flight_agg_",
+                "max(\"id\") AS \"__flight_agg_", " WHERE (\"id\" > 0) GROUP BY \"k\"");
+        // the WHERE is part of the remote aggregation; the scan keeps no predicate
+        assertNotContains(plan, "PREDICATES: ", "coalesce(");
+        assertContains(plan, "having: ");
+    }
+
+    @Test
+    public void testPreAggregationAbovePushedAggregationStreams() throws Exception {
+        // A-4: the partial groups of a pushed GROUP BY are already unique per endpoint; a hash-table
+        // pre-aggregation above them only doubles the memory of the merge
+        String sql = "select k, count(*), min(id) from " + T2 + " group by k";
+        int stage = connectContext.getSessionVariable().getNewPlannerAggStage();
+        try {
+            connectContext.getSessionVariable().setNewPlanerAggStage(2);
+            String plan = getVerboseExplain(sql);
+            assertContains(plan, "__flight_agg_", "streaming preaggregation mode: force_streaming");
+            connectContext.getSessionVariable().setFlightAggregatePushdown(false);
+            plan = getVerboseExplain(sql);
+            assertNotContains(plan, "__flight_agg_", "streaming preaggregation mode: force_streaming");
+        } finally {
+            connectContext.getSessionVariable().setFlightAggregatePushdown(true);
+            connectContext.getSessionVariable().setNewPlanerAggStage(stage);
+        }
+    }
