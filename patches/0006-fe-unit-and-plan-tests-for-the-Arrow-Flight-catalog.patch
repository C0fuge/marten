+package com.starrocks.connector.flight;
+
+import com.google.common.collect.ImmutableList;
+import org.apache.arrow.flight.FlightDescriptor;
+import org.apache.arrow.flight.FlightEndpoint;
+import org.apache.arrow.flight.FlightInfo;
+import org.apache.arrow.flight.Location;
+import org.apache.arrow.flight.Ticket;
+import org.apache.arrow.vector.FieldVector;
+import org.apache.arrow.vector.types.FloatingPointPrecision;
+import org.apache.arrow.vector.types.pojo.ArrowType;
+import org.apache.arrow.vector.types.pojo.Field;
+import org.apache.arrow.vector.types.pojo.FieldType;
+import org.apache.arrow.vector.types.pojo.Schema;
+
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.List;
+import java.util.concurrent.atomic.AtomicInteger;
+import java.util.function.BiFunction;
+
+/**
+ * Flight SQL metadata client without a server: one schema {@code s1} with tables {@code t1(id INT, k VARCHAR,
+ * price FLOAT)} ({@link #ROW_COUNT} rows) and {@code t2} (same columns, {@link #BIG_ROW_COUNT} rows); every planned
+ * query gets two endpoints. The planned SQL and the number of count queries are recorded. Min/max queries answer
+ * for {@code id} only (the one column with a range): t1 1..{@link #ROW_COUNT}, t2 1..{@link #BIG_ROW_COUNT}, split
+ * over two endpoint rows.
+ */
+public class MockedFlightSqlMetadataClient extends FlightSqlMetadataClient {
+    public static final String SCHEMA = "s1";
+    public static final String TABLE = "t1";
+    public static final String LOCATION = "grpc://127.0.0.1:31337";
+    public static final long ROW_COUNT = 1000;
+    public static final String BIG_TABLE = "t2";
+    public static final long BIG_ROW_COUNT = 10_000_000;
+
+    private final List<String> executed = Collections.synchronizedList(new ArrayList<>());
+    private final AtomicInteger countQueries = new AtomicInteger();
+    private final List<String> statsQueries = Collections.synchronizedList(new ArrayList<>());
+
+    public MockedFlightSqlMetadataClient(FlightProperties props) {
+        super(props);
+    }
+
+    public static Schema t1Schema() {
+        return new Schema(ImmutableList.of(
+                new Field("id", FieldType.nullable(new ArrowType.Int(32, true)), null),
+                new Field("k", FieldType.nullable(ArrowType.Utf8.INSTANCE), null),
+                new Field("price", FieldType.nullable(new ArrowType.FloatingPoint(FloatingPointPrecision.SINGLE)),
+                        null)));
+    }
+
+    @Override
+    public List<String> listSchemas() {
+        return ImmutableList.of(SCHEMA);
+    }
+
+    @Override
+    public List<String> listTables(String schema) {
+        return SCHEMA.equals(schema) ? ImmutableList.of(TABLE, BIG_TABLE) : ImmutableList.of();
+    }
+
+    @Override
+    public RemoteTable getTable(String schema, String table) {
+        if (!SCHEMA.equals(schema) || !(TABLE.equals(table) || BIG_TABLE.equals(table))) {
+            return null;
+        }
+        return new RemoteTable(null, schema, table, t1Schema());
+    }
+
+    @Override
+    public FlightInfo execute(String sql) {
+        executed.add(sql);
+        Location location = Location.forGrpcInsecure("127.0.0.1", 31337);
+        List<FlightEndpoint> endpoints = ImmutableList.of(
+                new FlightEndpoint(new Ticket("e0".getBytes(StandardCharsets.UTF_8)), location),
+                new FlightEndpoint(new Ticket("e1".getBytes(StandardCharsets.UTF_8)), location));
+        return new FlightInfo(t1Schema(), FlightDescriptor.command(sql.getBytes(StandardCharsets.UTF_8)), endpoints,
+                -1, rowCountOf(sql));
+    }
+
+    @Override
+    public long querySumOfLong(String sql) {
+        countQueries.incrementAndGet();
+        return rowCountOf(sql);
+    }
+
+    @Override
+    public List<Object[]> queryRows(String sql, BiFunction<FieldVector, Integer, Object> mapper) {
+        statsQueries.add(sql);
+        double max = rowCountOf(sql);
+        // one row per endpoint, as in result mode partial; the second endpoint has no rows for t1
+        return sql.contains("\"" + BIG_TABLE + "\"")
+                ? ImmutableList.of(new Object[] {1.0, max / 2}, new Object[] {max / 2 + 1, max})
+                : ImmutableList.of(new Object[] {1.0, max}, new Object[] {null, null});
+    }
+
+    public List<String> getStatsQueries() {
+        return ImmutableList.copyOf(statsQueries);
+    }
+
+    private static long rowCountOf(String sql) {
+        return sql.contains("\"" + BIG_TABLE + "\"") ? BIG_ROW_COUNT : ROW_COUNT;
+    }
+
+    public int getCountQueries() {
+        return countQueries.get();
+    }
+
+    @Override
+    public String currentLocation() {
+        return LOCATION;
+    }
+
+    public List<String> getExecuted() {
+        return ImmutableList.copyOf(executed);
+    }
+}
