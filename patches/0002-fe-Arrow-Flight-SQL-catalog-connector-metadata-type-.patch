+package com.starrocks.connector.flight;
+
+import com.starrocks.connector.Connector;
+import com.starrocks.connector.ConnectorContext;
+import com.starrocks.connector.ConnectorMetadata;
+
+import java.util.Map;
+import java.util.concurrent.ConcurrentHashMap;
+
+/**
+ * Arrow Flight SQL external catalog: {@code CREATE EXTERNAL CATALOG c PROPERTIES ("type" = "flight",
+ * "flight.uri" = "grpc://host:port", "flight.token" = "...")}. Metadata comes from Flight SQL; scans are
+ * planned with one GetFlightInfo and the endpoints are read natively by the BEs/CNs.
+ */
+public class FlightConnector implements Connector {
+    private static final Map<String, FlightMetadata> BY_CATALOG = new ConcurrentHashMap<>();
+
+    private final String catalogName;
+    private final FlightMetadata metadata;
+
+    public FlightConnector(ConnectorContext context) {
+        this.catalogName = context.getCatalogName();
+        FlightProperties props = new FlightProperties(context.getProperties());
+        this.metadata = new FlightMetadata(catalogName, props, new FlightSqlMetadataClient(props));
+        BY_CATALOG.put(catalogName, metadata);
+    }
+
+    @Override
+    public ConnectorMetadata getMetadata() {
+        return metadata;
+    }
+
+    /** Metadata of an initialized Flight catalog, used by the scan node; null if the catalog is unknown. */
+    public static FlightMetadata metadataOf(String catalogName) {
+        return BY_CATALOG.get(catalogName);
+    }
+
+    @Override
+    public void shutdown() {
+        BY_CATALOG.remove(catalogName, metadata);
+        metadata.shutdown();
+    }
+}
