+package com.starrocks.connector.flight;
+
+import com.starrocks.type.ArrayType;
+import com.starrocks.type.BooleanType;
+import com.starrocks.type.DateType;
+import com.starrocks.type.FloatType;
+import com.starrocks.type.IntegerType;
+import com.starrocks.type.JsonType;
+import com.starrocks.type.MapType;
+import com.starrocks.type.StructField;
+import com.starrocks.type.StructType;
+import com.starrocks.type.Type;
+import com.starrocks.type.TypeFactory;
+import com.starrocks.type.VarbinaryType;
+import org.apache.arrow.vector.types.pojo.ArrowType;
+import org.apache.arrow.vector.types.pojo.Field;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Locale;
+
+/**
+ * Maps Arrow field types (as announced by the Flight SQL server) to StarRocks column types.
+ *
+ * <p>Only types the BE converter ({@code arrow_to_starrocks_converter}) reads exactly are mapped; everything else
+ * returns {@code null} and the column is hidden from the table (not shown by DESC, never requested).
+ * Unsigned integers are widened because the BE copies same-width unsigned values bit by bit.
+ *
+ * <p>With {@code flight.converted_types=convert} (default) top-level columns of types without an exact StarRocks
+ * counterpart are exposed converted; the BE ({@code normalize_batch} in flight_connector.cpp) rewrites their Arrow
+ * arrays before the converter runs:
+ * <ul>
+ *   <li>Time32/64 → VARCHAR {@code HH:MM:SS[.f]} with 3 / 6 / 9 fraction digits for ms / us / ns;</li>
+ *   <li>Duration → BIGINT, the count in the Arrow unit (named in the column comment);</li>
+ *   <li>Interval → VARCHAR ISO-8601 ({@code P1Y2M3DT4H5M6.5S}, a sign per component, {@code PT0S} for zero);</li>
+ *   <li>Decimal256(p ≤ 38) → DECIMAL(p,s), wider → VARCHAR (plain decimal text);</li>
+ *   <li>Utf8View / BinaryView / ListView / LargeListView → VARCHAR / VARBINARY / ARRAY (exact).</li>
+ * </ul>
+ * Converted columns other than the *View types are never used in pushed filters or aggregations.
+ * Inside nested types only exact mappings are used.
+ */
+public final class FlightTypeMapper {
+    /** StarRocks DECIMAL limit for values the BE reads from Arrow Decimal128. */
+    public static final int MAX_DECIMAL128_PRECISION = 38;
+
+    private FlightTypeMapper() {
+    }
+
+    /** Top-level column type: the exact mapping, else the converted one when {@code convert} is set, else null. */
+    public static Type toStarRocksType(Field field, FlightProperties.NestedTypes nested, boolean convert) {
+        Type exact = toStarRocksType(field, nested);
+        return exact != null || !convert ? exact : convertedType(field, nested);
+    }
+
+    /** Returns the StarRocks type for {@code field}, or {@code null} when the column must be hidden. */
+    public static Type toStarRocksType(Field field, FlightProperties.NestedTypes nested) {
+        ArrowType t = field.getType();
+        switch (t.getTypeID()) {
+            case Bool:
+                return BooleanType.BOOLEAN;
+            case Int: {
+                ArrowType.Int i = (ArrowType.Int) t;
+                int bits = i.getBitWidth();
+                if (i.getIsSigned()) {
+                    return bits == 8 ? IntegerType.TINYINT : bits == 16 ? IntegerType.SMALLINT
+                            : bits == 32 ? IntegerType.INT : IntegerType.BIGINT;
+                }
+                return bits == 8 ? IntegerType.SMALLINT : bits == 16 ? IntegerType.INT
+                        : bits == 32 ? IntegerType.BIGINT : IntegerType.LARGEINT;
+            }
+            case FloatingPoint: {
+                ArrowType.FloatingPoint f = (ArrowType.FloatingPoint) t;
+                switch (f.getPrecision()) {
+                    case HALF:
+                    case SINGLE:
+                        return FloatType.FLOAT;
+                    default:
+                        return FloatType.DOUBLE;
+                }
+            }
+            case Decimal: {
+                ArrowType.Decimal d = (ArrowType.Decimal) t;
+                if (d.getBitWidth() != 128 || d.getPrecision() < 1 || d.getPrecision() > MAX_DECIMAL128_PRECISION
+                        || d.getScale() < 0 || d.getScale() > d.getPrecision()) {
+                    return null;
+                }
+                return TypeFactory.createUnifiedDecimalType(d.getPrecision(), d.getScale());
+            }
+            case Utf8:
+            case LargeUtf8:
+                return TypeFactory.createDefaultCatalogString();
+            case Binary:
+            case LargeBinary:
+            case FixedSizeBinary:
+                return VarbinaryType.VARBINARY;
+            case Date:
+                return DateType.DATE;
+            case Timestamp:
+                return DateType.DATETIME;
+            case List:
+            case LargeList:
+            case FixedSizeList:
+            case Map:
+            case Struct:
+                return nestedType(field, nested);
+            default:
+                // Time, Duration, Interval, Union, Null, *View types, RunEndEncoded, Decimal256 ...
+                return null;
+        }
+    }
+
+    /** The type of a converted top-level column (see the class comment), or null if there is none. */
+    private static Type convertedType(Field field, FlightProperties.NestedTypes nested) {
+        ArrowType t = field.getType();
+        switch (t.getTypeID()) {
+            case Time:
+            case Interval:
+            case Utf8View:
+                return TypeFactory.createDefaultCatalogString();
+            case Duration:
+                return IntegerType.BIGINT;
+            case BinaryView:
+                return VarbinaryType.VARBINARY;
+            case Decimal: {
+                ArrowType.Decimal d = (ArrowType.Decimal) t;
+                if (d.getBitWidth() != 256 || d.getPrecision() < 1 || d.getScale() < 0
+                        || d.getScale() > d.getPrecision()) {
+                    return null;
+                }
+                return d.getPrecision() <= MAX_DECIMAL128_PRECISION
+                        ? TypeFactory.createUnifiedDecimalType(d.getPrecision(), d.getScale())
+                        : TypeFactory.createDefaultCatalogString();
+            }
+            case ListView:
+            case LargeListView: {
+                if (nested == FlightProperties.NestedTypes.HIDE || field.getChildren().size() != 1) {
+                    return null;
+                }
+                if (nested == FlightProperties.NestedTypes.JSON) {
+                    return JsonType.JSON;
+                }
+                Type item = toStarRocksType(field.getChildren().get(0), FlightProperties.NestedTypes.NATIVE);
+                return item == null ? null : new ArrayType(item);
+            }
+            default:
+                return null;
+        }
+    }
+
+    /**
+     * True if a column of this Arrow type is exposed through a value conversion (TIME, DURATION, INTERVAL,
+     * DECIMAL256): its StarRocks values are not the server's, so it must not appear in pushed SQL.
+     */
+    public static boolean isValueConverted(ArrowType t) {
+        switch (t.getTypeID()) {
+            case Time:
+            case Duration:
+            case Interval:
+                return true;
+            case Decimal:
+                return ((ArrowType.Decimal) t).getBitWidth() != 128;
+            default:
+                return false;
+        }
+    }
+
+    /** Column comment describing a value conversion, or null. */
+    public static String conversionComment(ArrowType t) {
+        switch (t.getTypeID()) {
+            case Time:
+                return "Arrow " + t + " as text HH:MM:SS[.fraction]";
+            case Duration:
+                return "Arrow duration, unit " + ((ArrowType.Duration) t).getUnit().name().toLowerCase(Locale.ROOT);
+            case Interval:
+                return "Arrow " + t + " as ISO-8601 text";
+            case Decimal:
+                return ((ArrowType.Decimal) t).getBitWidth() != 128 ? "Arrow " + t : null;
+            default:
+                return null;
+        }
+    }
+
+    private static Type nestedType(Field field, FlightProperties.NestedTypes nested) {
+        switch (nested) {
+            case HIDE:
+                return null;
+            case JSON:
+                return JsonType.JSON;
+            default:
+                return nativeNested(field);
+        }
+    }
+
+    private static Type nativeNested(Field field) {
+        ArrowType t = field.getType();
+        switch (t.getTypeID()) {
+            case List:
+            case LargeList:
+            case FixedSizeList: {
+                if (field.getChildren().size() != 1) {
+                    return null;
+                }
+                Type item = toStarRocksType(field.getChildren().get(0), FlightProperties.NestedTypes.NATIVE);
+                return item == null ? null : new ArrayType(item);
+            }
+            case Map: {
+                // Map<entries: Struct<key, value>>
+                if (field.getChildren().size() != 1 || field.getChildren().get(0).getChildren().size() != 2) {
+                    return null;
+                }
+                List<Field> kv = field.getChildren().get(0).getChildren();
+                Type k = toStarRocksType(kv.get(0), FlightProperties.NestedTypes.NATIVE);
+                Type v = toStarRocksType(kv.get(1), FlightProperties.NestedTypes.NATIVE);
+                if (k == null || v == null || k.isComplexType()) {
+                    return null;
+                }
+                return new MapType(k, v);
+            }
+            case Struct: {
+                if (field.getChildren().isEmpty()) {
+                    return null;
+                }
+                List<StructField> fields = new ArrayList<>();
+                for (Field child : field.getChildren()) {
+                    Type ct = toStarRocksType(child, FlightProperties.NestedTypes.NATIVE);
+                    if (ct == null || child.getName() == null || child.getName().isEmpty()) {
+                        return null;
+                    }
+                    fields.add(new StructField(child.getName(), ct));
+                }
+                return new StructType(fields, true);
+            }
+            default:
+                return null;
+        }
+    }
+
+    /** True if values of this StarRocks type can be compared in a pushed-down filter without semantic risk. */
+    public static boolean isFilterable(Type type) {
+        return type.isBoolean() || type.isIntegerType() || type.isLargeint() || type.isFloatingPointType()
+                || type.isDecimalOfAnyVersion() || type.isStringType() || type.isDate() || type.isDatetime();
+    }
+}
