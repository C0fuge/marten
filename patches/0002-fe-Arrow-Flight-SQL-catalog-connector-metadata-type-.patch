+/**
+ * Metadata of an Arrow Flight SQL catalog: databases are the server's db schemas, tables its tables.
+ * Lookups are cached for {@code flight.metadata_cache_ttl_s}; row counts and column min/max
+ * ({@code flight.column_stats}) are loaded asynchronously (planning waits for them only briefly, once per load) and
+ * kept for {@code flight.stats_cache_ttl_s}.
+ */
+public class FlightMetadata implements ConnectorMetadata {
+    private static final Logger LOG = LogManager.getLogger(FlightMetadata.class);
+    /**
+     * How long planning waits, once per load, for a row count that is not cached yet. Statistics are asked for
+     * many times per plan and the memo phase has a 3 s budget (new_planner_optimize_timeout), so a slow count must
+     * never be waited for again.
+     */
+    static final long ROW_COUNT_WAIT_MS = 250;
+    /** At most this many columns per table get min/max (one {@code SELECT min(c), max(c), ...} per table). */
+    static final int MAX_RANGE_COLUMNS = 100;
+    private static final ExecutorService STATS_EXECUTOR = Executors.newFixedThreadPool(4,
+            new ThreadFactoryBuilder().setDaemon(true).setNameFormat("flight-row-count-%d").build());
+
+    private final String catalogName;
+    private final FlightProperties props;
+    private final FlightSqlMetadataClient client;
+    private final Cache<String, List<String>> dbNames;
+    private final Cache<String, List<String>> tableNames;
+    private final Cache<List<String>, Optional<FlightTable>> tables;
+    private final Map<String, Database> databases = new java.util.concurrent.ConcurrentHashMap<>();
+    private final AsyncLoadingCache<List<String>, Long> rowCounts;
+    /** Column name to {min, max} as optimizer doubles (dates and datetimes: epoch seconds). */
+    private final AsyncLoadingCache<List<String>, Map<String, double[]>> columnRanges;
+    /** Statistics loads somebody already waited for (weak: a finished load is dropped with its cache entry). */
+    private final Set<CompletableFuture<?>> waitedLoads =
+            Collections.synchronizedSet(Collections.newSetFromMap(new WeakHashMap<>()));
+
+    public FlightMetadata(String catalogName, FlightProperties props, FlightSqlMetadataClient client) {
+        this.catalogName = catalogName;
+        this.props = props;
+        this.client = client;
+        long ttl = props.getMetadataCacheTtlSec();
+        this.dbNames = Caffeine.newBuilder().expireAfterWrite(ttl, TimeUnit.SECONDS).maximumSize(16).build();
+        this.tableNames = Caffeine.newBuilder().expireAfterWrite(ttl, TimeUnit.SECONDS).maximumSize(10_000).build();
+        this.tables = Caffeine.newBuilder().expireAfterWrite(ttl, TimeUnit.SECONDS).maximumSize(100_000).build();
+        long statsTtl = Math.max(1, props.getStatsCacheTtlSec());
+        this.rowCounts = Caffeine.newBuilder()
+                .maximumSize(100_000)
+                .refreshAfterWrite(statsTtl, TimeUnit.SECONDS)
+                .expireAfterWrite(statsTtl * 6, TimeUnit.SECONDS)
+                .executor(STATS_EXECUTOR)
+                .buildAsync(this::loadRowCount);
+        this.columnRanges = Caffeine.newBuilder()
+                .maximumSize(100_000)
+                .refreshAfterWrite(statsTtl, TimeUnit.SECONDS)
+                .expireAfterWrite(statsTtl * 6, TimeUnit.SECONDS)
+                .executor(STATS_EXECUTOR)
+                .buildAsync(this::loadColumnRanges);
+    }
+
+    public String getCatalogName() {
+        return catalogName;
+    }
+
+    public FlightProperties getProperties() {
+        return props;
+    }
+
+    public FlightSqlMetadataClient getClient() {
+        return client;
+    }
+
+    @Override
+    public Table.TableType getTableType() {
+        return Table.TableType.FLIGHT;
+    }
+
+    @Override
+    public List<String> listDbNames(ConnectContext context) {
+        if (props.getMetadataCacheTtlSec() == 0) {
+            return client.listSchemas();
+        }
+        return dbNames.get("", k -> client.listSchemas());
+    }
+
+    @Override
+    public List<String> listTableNames(ConnectContext context, String dbName) {
+        if (props.getMetadataCacheTtlSec() == 0) {
+            return client.listTables(dbName);
+        }
+        return tableNames.get(dbName, client::listTables);
+    }
+
+    @Override
+    public Database getDb(ConnectContext context, String name) {
+        if (!listDbNames(context).contains(name)) {
+            return null;
+        }
+        return databases.computeIfAbsent(name, d -> new Database(CONNECTOR_ID_GENERATOR.getNextId().asLong(), d));
+    }
+
+    @Override
+    public boolean dbExists(ConnectContext context, String dbName) {
+        return listDbNames(context).contains(dbName);
+    }
+
+    @Override
+    public Table getTable(ConnectContext context, String dbName, String tblName) {
+        List<String> key = ImmutableList.of(dbName, tblName);
+        if (props.getMetadataCacheTtlSec() == 0) {
+            return loadTable(dbName, tblName).orElse(null);
+        }
+        Table table = tables.get(key, k -> loadTable(dbName, tblName)).orElse(null);
+        if (table != null) {
+            // start the statistics now, so they are usually known when the optimizer asks for them
+            rowCounts.get(key);
+            if (props.isColumnStats()) {
+                columnRanges.get(key);
+            }
+        }
+        return table;
+    }
+
+    @Override
+    public boolean tableExists(ConnectContext context, String dbName, String tblName) {
+        return getTable(context, dbName, tblName) != null;
+    }
+
+    private Optional<FlightTable> loadTable(String dbName, String tblName) {
+        FlightSqlMetadataClient.RemoteTable remote = client.getTable(dbName, tblName);
+        if (remote == null || remote.arrowSchema == null) {
+            return Optional.empty();
+        }
+        List<Column> columns = new ArrayList<>();
+        Set<String> filterable = new HashSet<>();
+        Set<String> seen = new HashSet<>();
+        List<String> hidden = new ArrayList<>();
+        for (Field field : remote.arrowSchema.getFields()) {
+            String name = field.getName();
+            Type type = FlightTypeMapper.toStarRocksType(field, props.getNestedTypes(), props.isConvertTypes());
+            if (type == null || name == null || name.isEmpty() || !seen.add(name.toLowerCase(Locale.ROOT))) {
+                hidden.add(name + ":" + field.getType());
+                continue;
+            }
+            String comment = FlightTypeMapper.conversionComment(field.getType());
+            columns.add(comment == null ? new Column(name, type, true) : new Column(name, type, true, comment));
+            if (isFilterable(field, type)) {
+                filterable.add(name);
+            }
+        }
+        if (!hidden.isEmpty()) {
+            LOG.info("Flight catalog {}: table {}.{} hides {} column(s) without an exact StarRocks type: {}",
+                    catalogName, dbName, tblName, hidden.size(), hidden);
+        }
+        if (columns.isEmpty()) {
+            throw new StarRocksConnectorException("Table %s.%s has no column with a supported type", dbName, tblName);
+        }
+        return Optional.of(new FlightTable(catalogName, dbName, tblName, columns, filterable, hidden.size()));
+    }
+
+    /** Types whose comparisons and literals mean exactly the same on the server. */
+    private static boolean isFilterable(Field field, Type type) {
+        if (!FlightTypeMapper.isFilterable(type) || type.isFloat()
+                || FlightTypeMapper.isValueConverted(field.getType())) {
+            return false;
+        }
+        if (field.getType() instanceof ArrowType.Timestamp) {
+            // time-zoned timestamps are re-zoned to the session time zone by StarRocks
+            return ((ArrowType.Timestamp) field.getType()).getTimezone() == null;
+        }
+        return true;
+    }
+
+    @Override
+    public List<RemoteFileInfo> getRemoteFiles(Table table, GetRemoteFilesParams params) {
+        if (!(params instanceof FlightGetRemoteFilesParams)) {
+            throw new StarRocksConnectorException("Flight scan planning needs the remote SQL");
+        }
+        String sql = ((FlightGetRemoteFilesParams) params).getRemoteSql();
+        FlightInfo info = client.execute(sql);
+        List<FlightRemoteFileDesc.Endpoint> endpoints = new ArrayList<>();
+        for (FlightEndpoint e : info.getEndpoints()) {
+            List<String> locations = new ArrayList<>();
+            for (Location l : e.getLocations()) {
+                locations.add(l.getUri().toString());
+            }
+            endpoints.add(new FlightRemoteFileDesc.Endpoint(e.getTicket().getBytes(), locations));
+        }
+        RemoteFileInfo fileInfo = new RemoteFileInfo();
+        List<RemoteFileDesc> files = new ArrayList<>();
+        files.add(new FlightRemoteFileDesc(endpoints, info.getRecords(), client.currentLocation()));
+        fileInfo.setFiles(files);
+        List<RemoteFileInfo> result = new ArrayList<>();
+        result.add(fileInfo);
+        return result;
+    }
+
+    private Long loadRowCount(List<String> key) {
+        try {
+            String sql = "SELECT count(*) FROM " + FlightSqlRenderer.tableRef(key.get(0), key.get(1));
+            return client.querySumOfLong(sql);
+        } catch (Exception e) {
+            LOG.warn("Flight catalog {}: row count of {}.{} failed: {}", catalogName, key.get(0), key.get(1),
+                    e.getMessage());
+            return -1L;
+        }
+    }
+
+    /** Columns that get min/max: exact comparisons on the server (filterable) and a numeric or date range. */
+    static List<Column> rangeColumns(FlightTable table) {
+        List<Column> result = new ArrayList<>();
+        for (Column c : table.getFullSchema()) {
+            Type t = c.getType();
+            if (table.isFilterable(c.getName()) && (t.isNumericType() || t.isDateType())) {
+                result.add(c);
+                if (result.size() == MAX_RANGE_COLUMNS) {
+                    break;
+                }
+            }
+        }
+        return result;
+    }
+
+    private Map<String, double[]> loadColumnRanges(List<String> key) {
+        try {
+            Optional<FlightTable> table = props.getMetadataCacheTtlSec() == 0 ? loadTable(key.get(0), key.get(1))
+                    : tables.get(key, k -> loadTable(key.get(0), key.get(1)));
+            List<Column> columns = table.isPresent() ? rangeColumns(table.get()) : Collections.emptyList();
+            if (columns.isEmpty()) {
+                return Collections.emptyMap();
+            }
+            StringBuilder sql = new StringBuilder("SELECT ");
+            for (int i = 0; i < columns.size(); i++) {
+                String c = FlightSqlRenderer.quoteIdent(columns.get(i).getName());
+                sql.append(i == 0 ? "" : ", ").append("min(").append(c).append("), max(").append(c).append(')');
+            }
+            sql.append(" FROM ").append(FlightSqlRenderer.tableRef(key.get(0), key.get(1)));
+            // partial mode: one row per endpoint
+            List<Object[]> rows = client.queryRows(sql.toString(), FlightMetadata::optimizerValue);
+            Map<String, double[]> result = new HashMap<>();
+            for (int i = 0; i < columns.size(); i++) {
+                double min = Double.NaN;
+                double max = Double.NaN;
+                for (Object[] row : rows) {
+                    if (row.length != columns.size() * 2) {
+                        throw new StarRocksConnectorException("unexpected result width %d", row.length);
+                    }
+                    if (row[2 * i] instanceof Double) {
+                        min = Double.isNaN(min) ? (Double) row[2 * i] : Math.min(min, (Double) row[2 * i]);
+                    }
+                    if (row[2 * i + 1] instanceof Double) {
+                        max = Double.isNaN(max) ? (Double) row[2 * i + 1] : Math.max(max, (Double) row[2 * i + 1]);
+                    }
+                }
+                if (!Double.isNaN(min) && !Double.isNaN(max) && min <= max) {
+                    result.put(columns.get(i).getName(), new double[] {min, max});
+                }
+            }
+            return result;
+        } catch (Exception e) {
+            LOG.warn("Flight catalog {}: column min/max of {}.{} failed: {}", catalogName, key.get(0), key.get(1),
+                    e.getMessage());
+            return Collections.emptyMap();
+        }
+    }
+
+    /** A min/max result value as the optimizer stores it (dates and datetimes: epoch seconds), or null. */
+    public static Object optimizerValue(FieldVector v, int row) {
+        if (v instanceof DateDayVector) {
+            return epochDayValue(((DateDayVector) v).get(row));
+        }
+        if (v instanceof UInt8Vector) {
+            return ((UInt8Vector) v).getObjectNoOverflow(row).doubleValue();
+        }
+        // timestamps without a time zone and date64 read as LocalDateTime, numbers as Number
+        return optimizerValue(v.getObject(row));
+    }
+
+    public static Double epochDayValue(int epochDay) {
+        return (double) Utils.getLongFromDateTime(LocalDate.ofEpochDay(epochDay).atStartOfDay());
+    }
+
+    public static Double optimizerValue(Object o) {
+        if (o instanceof LocalDateTime) {
+            return (double) Utils.getLongFromDateTime((LocalDateTime) o);
+        }
+        return o instanceof Number ? ((Number) o).doubleValue() : null;
+    }
+
+    /**
+     * Value of a statistics load, or null if not known yet. The first caller of a load waits for it until
+     * {@code deadlineNanos} (the server answers count(*), min and max from Parquet footers); later callers do not
+     * wait, and the load goes on in the background.
+     */
+    private <T> T getBounded(CompletableFuture<T> f, long deadlineNanos) {
+        T v = f.getNow(null);
+        if (v == null && waitedLoads.add(f)) {
+            try {
+                v = f.get(Math.max(0, deadlineNanos - System.nanoTime()), TimeUnit.NANOSECONDS);
+            } catch (InterruptedException e) {
+                Thread.currentThread().interrupt();
+            } catch (ExecutionException | TimeoutException e) {
+                // not known yet
+            }
+        }
+        return v;
+    }
+
+    /** Cached row count, or -1 if not known yet (bounded wait, see {@link #getBounded}). */
+    public long getRowCount(FlightTable table) {
+        return getRowCount(table, System.nanoTime() + TimeUnit.MILLISECONDS.toNanos(ROW_COUNT_WAIT_MS));
+    }
+
+    private long getRowCount(FlightTable table, long deadlineNanos) {
+        Long v = getBounded(rowCounts.get(key(table)), deadlineNanos);
+        return v == null ? -1 : v;
+    }
+
+    /** Cached column min/max (column name to {min, max}); empty if not known (yet) or disabled. */
+    public Map<String, double[]> getColumnRanges(FlightTable table) {
+        return getColumnRanges(table, System.nanoTime() + TimeUnit.MILLISECONDS.toNanos(ROW_COUNT_WAIT_MS));
+    }
+
+    private Map<String, double[]> getColumnRanges(FlightTable table, long deadlineNanos) {
+        if (!props.isColumnStats()) {
+            return Collections.emptyMap();
+        }
+        Map<String, double[]> v = getBounded(columnRanges.get(key(table)), deadlineNanos);
+        return v == null ? Collections.emptyMap() : v;
+    }
+
+    private static List<String> key(FlightTable table) {
+        return ImmutableList.of(table.getCatalogDBName(), table.getCatalogTableName());
+    }
+
+    @Override
+    public Statistics getTableStatistics(OptimizerContext session, Table table, Map<ColumnRefOperator, Column> columns,
+                                         List<PartitionKey> partitionKeys, ScalarOperator predicate, long limit,
+                                         TvrVersionRange versionRange) {
+        // row count and column min/max are loaded in parallel; together they wait at most ROW_COUNT_WAIT_MS
+        long deadline = System.nanoTime() + TimeUnit.MILLISECONDS.toNanos(ROW_COUNT_WAIT_MS);
+        long known = getRowCount((FlightTable) table, deadline);
+        Map<String, double[]> ranges = getColumnRanges((FlightTable) table, deadline);
+        long rowCount = known >= 0 ? known : Config.default_statistics_output_row_count;
+        Statistics.Builder builder = Statistics.builder();
+        if (known >= 0) {
+            builder.setStatsSource(Statistics.StatsSource.TABLE_METADATA);
+        }
+        builder.setOutputRowCount(Math.max(1, rowCount));
+        // only columns with a known min/max get statistics; the others stay UNKNOWN (as without this connector's
+        // statistics), the optimizer then uses its defaults for them
+        for (Map.Entry<ColumnRefOperator, Column> entry : columns.entrySet()) {
+            double[] range = ranges.get(entry.getValue().getName());
+            if (range == null) {
+                builder.addColumnStatistic(entry.getKey(), ColumnStatistic.unknown());
+                continue;
+            }
+            ConnectorNdvEstimator.TypeCategory cat = ConnectorNdvEstimator.fromStarRocksType(entry.getValue().getType());
+            double ndv = ConnectorNdvEstimator.estimate(cat, range[0], range[1], -1L, 0L, rowCount);
+            builder.addColumnStatistic(entry.getKey(), ColumnStatistic.builder()
+                    .setMinValue(range[0])
+                    .setMaxValue(range[1])
+                    .setDistinctValuesCount(Math.max(1.0, Math.min(ndv, rowCount)))
+                    .setAverageRowSize(entry.getValue().getType().getTypeSize())
+                    .setNullsFraction(0)
+                    .setType(ColumnStatistic.StatisticType.ESTIMATE)
+                    .build());
+        }
+        return builder.build();
+    }
+
+    @Override
+    public void refreshTable(String srDbName, Table table, List<String> partitionNames, boolean onlyCachedPartitions) {
+        tables.invalidate(ImmutableList.of(srDbName, table.getCatalogTableName()));
+        tableNames.invalidate(srDbName);
+        dbNames.invalidateAll();
+        rowCounts.synchronous().invalidate(ImmutableList.of(srDbName, table.getCatalogTableName()));
+        columnRanges.synchronous().invalidate(ImmutableList.of(srDbName, table.getCatalogTableName()));
+    }
+
+    /**
+     * Keeps every cache: MetadataMgr calls clear() on the query-level metadata at the end of EVERY query, and
+     * this object is the catalog's only metadata, so clearing here left each plan with a cold row-count cache
+     * (no CBO statistics). The caches expire by their TTLs; REFRESH EXTERNAL TABLE uses refreshTable().
+     */
+    @Override
+    public void clear() {
+    }
+
+    @Override
+    public void shutdown() {
+        client.close();
+    }
+
+    @Override
+    public boolean equals(Object o) {
+        return this == o;
+    }
+
+    @Override
+    public int hashCode() {
+        return Objects.hashCode(catalogName);
+    }
+}
