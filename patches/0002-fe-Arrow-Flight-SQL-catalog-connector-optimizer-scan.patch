+package com.starrocks.catalog;
+
+import com.google.common.collect.ImmutableSet;
+import com.starrocks.planner.DescriptorTable;
+import com.starrocks.thrift.TTableDescriptor;
+import com.starrocks.thrift.TTableType;
+
+import java.util.List;
+import java.util.Set;
+
+import static com.starrocks.connector.ConnectorTableId.CONNECTOR_ID_GENERATOR;
+
+/**
+ * A table of an Arrow Flight SQL catalog. Columns are the remote columns whose Arrow types the BE can read;
+ * other remote columns are not part of the table. Holds no credentials.
+ */
+public class FlightTable extends Table {
+    private final String catalogName;
+    private final String dbName;
+    private final String remoteTableName;
+    /** Columns whose values compare identically on the server, so filters on them may be pushed down. */
+    private final Set<String> filterableColumns;
+    private final int hiddenColumnCount;
+
+    public FlightTable(String catalogName, String dbName, String tableName, List<Column> schema,
+                       Set<String> filterableColumns, int hiddenColumnCount) {
+        super(CONNECTOR_ID_GENERATOR.getNextId().asLong(), tableName, TableType.FLIGHT, schema);
+        this.catalogName = catalogName;
+        this.dbName = dbName;
+        this.remoteTableName = tableName;
+        this.filterableColumns = ImmutableSet.copyOf(filterableColumns);
+        this.hiddenColumnCount = hiddenColumnCount;
+    }
+
+    @Override
+    public String getCatalogName() {
+        return catalogName;
+    }
+
+    @Override
+    public String getCatalogDBName() {
+        return dbName;
+    }
+
+    @Override
+    public String getCatalogTableName() {
+        return remoteTableName;
+    }
+
+    public boolean isFilterable(String columnName) {
+        return filterableColumns.contains(columnName);
+    }
+
+    public int getHiddenColumnCount() {
+        return hiddenColumnCount;
+    }
+
+    @Override
+    public boolean isSupported() {
+        return true;
+    }
+
+    @Override
+    public String getTableIdentifier() {
+        return String.join(":", catalogName, dbName, remoteTableName);
+    }
+
+    @Override
+    public TTableDescriptor toThrift(List<DescriptorTable.ReferencedPartitionInfo> partitions) {
+        return new TTableDescriptor(id, TTableType.FLIGHT_TABLE, fullSchema.size(), 0, remoteTableName, dbName);
+    }
+}
