+import org.apache.arrow.flight.FlightRuntimeException;
+import org.apache.arrow.flight.FlightStatusCode;
+import org.apache.arrow.flight.FlightStream;
+import org.apache.arrow.flight.HeaderCallOption;
+import org.apache.arrow.flight.Location;
+import org.apache.arrow.flight.auth2.BearerCredentialWriter;
+import org.apache.arrow.flight.grpc.CredentialCallOption;
+import org.apache.arrow.flight.sql.FlightSqlClient;
+import org.apache.arrow.memory.BufferAllocator;
+import org.apache.arrow.memory.RootAllocator;
+import org.apache.arrow.vector.FieldVector;
+import org.apache.arrow.vector.VectorSchemaRoot;
+import org.apache.arrow.vector.ipc.ReadChannel;
+import org.apache.arrow.vector.ipc.message.MessageSerializer;
+import org.apache.arrow.vector.types.pojo.Schema;
+import org.apache.logging.log4j.LogManager;
+import org.apache.logging.log4j.Logger;
+
+import java.io.ByteArrayInputStream;
+import java.io.IOException;
+import java.net.URI;
+import java.nio.channels.Channels;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+import java.util.Objects;
+import java.util.concurrent.TimeUnit;
+import java.util.function.BiFunction;
+
+/**
+ * Flight SQL client used by the FE: catalog metadata (schemas, tables, Arrow schemas), row counts and scan
+ * planning (GetFlightInfo). One client per catalog; the catalog URI list gives failover for these calls.
+ * Secrets (token, password) are never logged or put into exception messages.
+ */
+public class FlightSqlMetadataClient implements AutoCloseable {
+    private static final Logger LOG = LogManager.getLogger(FlightSqlMetadataClient.class);
+    private static final long ALLOCATOR_LIMIT = 512L * 1024 * 1024;
+    private static final long DEFAULT_UNARY_TIMEOUT_MS = 30_000;
+
+    /** A table advertised by the server; {@code schema} may be null if the server did not include it. */
+    public static final class RemoteTable {
+        public final String catalog;
+        public final String schema;
+        public final String name;
+        public final Schema arrowSchema;
+
+        RemoteTable(String catalog, String schema, String name, Schema arrowSchema) {
+            this.catalog = catalog;
+            this.schema = schema;
+            this.name = name;
+            this.arrowSchema = arrowSchema;
+        }
+    }
+
+    /** One connection to one catalog URI. FlightClient is thread-safe; calls run concurrently. */
+    private static final class Conn {
+        final int uriIndex;
+        final FlightClient client;
+        final FlightSqlClient sql;
+        final CallOption credential;
+
+        Conn(int uriIndex, FlightClient client, CallOption credential) {
+            this.uriIndex = uriIndex;
+            this.client = client;
+            this.sql = new FlightSqlClient(client);
+            this.credential = credential;
+        }
+    }
+
+    private final FlightProperties props;
+    private final BufferAllocator allocator;
+    private final Object lock = new Object();
+    private volatile Conn conn;
+
+    public FlightSqlMetadataClient(FlightProperties props) {
+        this.props = Objects.requireNonNull(props);
+        this.allocator = new RootAllocator(ALLOCATOR_LIMIT);
+    }
+
+    private FlightClient buildClient(URI uri) {
+        FlightClient.Builder b = FlightClient.builder().allocator(allocator).location(new Location(uri))
+                .maxInboundMessageSize(64 * 1024 * 1024);
+        if (uri.getScheme().equalsIgnoreCase("grpc+tls")) {
+            b.useTls();
+            if (!props.isTlsVerify()) {
+                b.verifyServer(false);
+            }
+            if (props.getTlsRootCerts() != null) {
+                b.trustedCertificates(
+                        new ByteArrayInputStream(props.getTlsRootCerts().getBytes(StandardCharsets.US_ASCII)));
+            }
+            if (props.getTlsOverrideHostname() != null) {
+                b.overrideHostname(props.getTlsOverrideHostname());
+            }
+        }
+        return b.build();
+    }
+
+    private Conn connect(int uriIndex) {
+        URI uri = props.getUris().get(uriIndex);
+        FlightClient c = buildClient(uri);
+        try {
+            CallOption cred = null;
+            if (props.getToken() != null) {
+                cred = new CredentialCallOption(new BearerCredentialWriter(props.getToken()));
+            } else if (props.getUser() != null) {
+                cred = c.authenticateBasicToken(props.getUser(),
+                        props.getPassword() == null ? "" : props.getPassword()).orElse(null);
+            }
+            return new Conn(uriIndex, c, cred);
+        } catch (RuntimeException e) {
+            closeClient(c);
+            throw e;
+        }
+    }
+
+    /** Current connection, created on first use (on the URI after {@code failedIndex} if one failed). */
+    private Conn current(Conn failed, int nextIndex) {
+        synchronized (lock) {
+            Conn c = conn;
+            if (c != null && c != failed) {
+                return c;
+            }
+            if (c != null) {
+                closeClient(c.client);
+                conn = null;
+            }
+            Conn fresh = connect(nextIndex);
+            conn = fresh;
+            return fresh;
+        }
+    }
+
+    private CallOption[] options(Conn c, long timeoutMs) {
+        List<CallOption> opts = new ArrayList<>();
+        if (c.credential != null) {
+            opts.add(c.credential);
+        }
+        CallHeaders headers = new FlightCallHeaders();
+        for (Map.Entry<String, String> e : props.getCallHeaders().entrySet()) {
+            headers.insert(e.getKey(), e.getValue());
+        }
+        opts.add(new HeaderCallOption(headers));
+        if (timeoutMs > 0) {
+            opts.add(CallOptions.timeout(timeoutMs, TimeUnit.MILLISECONDS));
+        }
+        return opts.toArray(new CallOption[0]);
+    }
+
+    private long unaryTimeoutMs() {
+        return props.getRpcTimeoutMs() > 0 ? props.getRpcTimeoutMs() : DEFAULT_UNARY_TIMEOUT_MS;
+    }
+
+    private static boolean isUnreachable(FlightRuntimeException e) {
+        FlightStatusCode code = e.status().code();
+        return code == FlightStatusCode.UNAVAILABLE || code == FlightStatusCode.TIMED_OUT;
+    }
+
+    /**
+     * Runs {@code call}; on an "unreachable" error it moves on to the next catalog URI (each URI at most once
+     * per call). With user/password, UNAUTHENTICATED (expired session) leads to one new handshake.
+     */
+    private <T> T withFailover(String what, BiFunction<Conn, CallOption[], T> call) {
+        int n = props.getUris().size();
+        RuntimeException last = null;
+        Conn failed = null;
+        int next = 0;
+        boolean reauthenticated = false;
+        for (int attempt = 0; attempt < n; attempt++) {
+            Conn c;
+            try {
+                c = current(failed, next);
+            } catch (FlightRuntimeException e) {
+                last = e;
+                if (!isUnreachable(e)) {
+                    break;
+                }
+                LOG.warn("Flight {}: cannot connect to {} ({}), trying next location", what,
+                        props.getUris().get(next), e.status().code());
+                next = (next + 1) % n;
+                continue;
+            }
+            try {
+                return call.apply(c, options(c, unaryTimeoutMs()));
+            } catch (FlightRuntimeException e) {
+                last = e;
+                failed = c;
+                next = c.uriIndex;
+                if (e.status().code() == FlightStatusCode.UNAUTHENTICATED && props.getUser() != null
+                        && !reauthenticated) {
+                    reauthenticated = true;
+                    attempt--;
+                    continue;
+                }
+                if (!isUnreachable(e)) {
+                    break;
+                }
+                LOG.warn("Flight {} failed on {} ({}), trying next location", what,
+                        props.getUris().get(c.uriIndex), e.status().code());
+                next = (c.uriIndex + 1) % n;
+            }
+        }
+        throw new StarRocksConnectorException("Flight " + what + " failed: " + describe(last), last);
+    }
+
+    static String describe(Throwable t) {
+        if (t == null) {
+            return "unknown error";
+        }
+        if (t instanceof FlightRuntimeException) {
+            FlightRuntimeException f = (FlightRuntimeException) t;
+            String d = f.status().description();
+            return f.status().code() + (d == null || d.isEmpty() ? "" : ": " + d);
+        }
+        return t.getMessage();
+    }
+
+    /** Reads all rows of all endpoints of a metadata FlightInfo. */
+    private <T> List<T> readRows(Conn c, FlightInfo info, BiFunction<VectorSchemaRoot, Integer, T> mapper) {
+        List<T> result = new ArrayList<>();
+        for (FlightEndpoint endpoint : info.getEndpoints()) {
+            FlightClient streamClient = c.client;
+            boolean own = false;
+            URI loc = endpoint.getLocations().isEmpty() ? null : endpoint.getLocations().get(0).getUri();
+            if (loc != null && !isSameAs(c, loc)) {
+                streamClient = buildClient(loc);
+                own = true;
+            }
+            try (FlightStream stream = streamClient.getStream(endpoint.getTicket(), options(c, unaryTimeoutMs()))) {
+                while (stream.next()) {
+                    VectorSchemaRoot root = stream.getRoot();
+                    for (int row = 0; row < root.getRowCount(); row++) {
+                        T item = mapper.apply(root, row);
+                        if (item != null) {
+                            result.add(item);
+                        }
+                    }
+                }
+            } catch (FlightRuntimeException e) {
+                throw e;
+            } catch (Exception e) {
+                throw new StarRocksConnectorException("Flight metadata stream failed: " + e.getMessage(), e);
+            } finally {
+                if (own) {
+                    closeClient(streamClient);
+                }
+            }
+        }
+        return result;
+    }
+
+    private boolean isSameAs(Conn c, URI loc) {
+        String scheme = loc.getScheme();
+        if (scheme == null || scheme.startsWith("arrow-flight-reuse-connection")) {
+            return true;
+        }
+        URI cur = props.getUris().get(c.uriIndex);
+        return Objects.equals(loc.getHost(), cur.getHost()) && loc.getPort() == cur.getPort();
+    }
+
+    private static String text(VectorSchemaRoot root, int row, String column) {
+        FieldVector v = root.getVector(column);
+        if (v == null) {
+            return null;
+        }
+        Object value = v.getObject(row);
+        return value == null ? null : value.toString();
+    }
+
+    private boolean catalogMatches(String rowCatalog) {
+        String wanted = props.getFlightCatalog();
+        return wanted == null || wanted.equals(rowCatalog);
+    }
+
+    public List<String> listSchemas() {
+        return withFailover("GetDbSchemas", (c, opts) -> {
+            FlightInfo info = c.sql.getSchemas(props.getFlightCatalog(), null, opts);
+            List<String> rows = readRows(c, info, (root, row) ->
+                    catalogMatches(text(root, row, "catalog_name")) ? text(root, row, "db_schema_name") : null);
+            return ImmutableList.copyOf(rows.stream().distinct().iterator());
+        });
+    }
+
+    public List<String> listTables(String schema) {
+        return withFailover("GetTables", (c, opts) -> {
+            FlightInfo info = c.sql.getTables(props.getFlightCatalog(), schema, null, null, false, opts);
+            List<String> rows = readRows(c, info, (root, row) -> {
+                if (!catalogMatches(text(root, row, "catalog_name"))
+                        || !schema.equals(text(root, row, "db_schema_name"))) {
+                    return null;
+                }
+                return text(root, row, "table_name");
+            });
+            return ImmutableList.copyOf(rows.stream().distinct().iterator());
+        });
+    }
+
+    /** Returns the table with its Arrow schema, or null if it does not exist. */
+    public RemoteTable getTable(String schema, String table) {
+        RemoteTable found = withFailover("GetTables", (c, opts) -> {
+            FlightInfo info = c.sql.getTables(props.getFlightCatalog(), schema, table, null, true, opts);
+            List<RemoteTable> rows = readRows(c, info, (root, row) -> {
+                if (!catalogMatches(text(root, row, "catalog_name"))
+                        || !schema.equals(text(root, row, "db_schema_name"))
+                        || !table.equals(text(root, row, "table_name"))) {
+                    return null;
+                }
+                Schema s = null;
+                FieldVector v = root.getVector("table_schema");
+                if (v != null && !v.isNull(row)) {
+                    s = deserializeSchema((byte[]) v.getObject(row));
+                }
+                return new RemoteTable(text(root, row, "catalog_name"), schema, table, s);
+            });
+            return rows.isEmpty() ? null : rows.get(0);
+        });
+        if (found == null || found.arrowSchema != null) {
+            return found;
+        }
+        Schema s = withFailover("GetExecuteSchema", (c, opts) -> c.sql.getExecuteSchema(
+                "SELECT * FROM " + FlightSqlRenderer.tableRef(schema, table), opts).getSchema());
+        return new RemoteTable(found.catalog, schema, table, s);
+    }
+
+    static Schema deserializeSchema(byte[] bytes) {
+        try {
+            return MessageSerializer.deserializeSchema(
+                    new ReadChannel(Channels.newChannel(new ByteArrayInputStream(bytes))));
+        } catch (IOException e) {
+            throw new StarRocksConnectorException("Cannot decode table schema from the Flight server: " + e.getMessage());
+        }
+    }
+
+    /** Plans a query: one GetFlightInfo call; the endpoints are read by the BEs. */
+    public FlightInfo execute(String sql) {
+        return withFailover("GetFlightInfo", (c, opts) -> c.sql.execute(sql, opts));
+    }
+
+    /**
+     * Runs a query whose result is a single BIGINT column and returns the sum over all rows of all endpoints
+     * (in partial mode every endpoint returns its own count).
+     */
+    public long querySumOfLong(String sql) {
+        return withFailover("count query", (c, opts) -> {
+            FlightInfo info = c.sql.execute(sql, opts);
+            List<Long> parts = readRows(c, info, (root, row) -> {
+                Object v = root.getFieldVectors().get(0).getObject(row);
+                return v == null ? 0L : ((Number) v).longValue();
+            });
+            long sum = 0;
+            for (Long p : parts) {
+                sum += p;
+            }
+            return sum;
+        });
+    }
+
+    /** Location of the URI currently in use, sent to the BE as the default endpoint location. */
+    public String currentLocation() {
+        Conn c = conn;
+        return props.getUris().get(c == null ? 0 : c.uriIndex).toString();
+    }
+
+    private static void closeClient(FlightClient c) {
+        try {
+            c.close();
+        } catch (InterruptedException e) {
+            Thread.currentThread().interrupt();
+        } catch (Exception e) {
+            LOG.debug("closing Flight client", e);
+        }
+    }
+
+    @Override
+    public void close() {
+        synchronized (lock) {
+            if (conn != null) {
+                closeClient(conn.client);
+                conn = null;
+            }
+            try {
+                allocator.close();
+            } catch (Exception e) {
+                LOG.warn("closing Flight allocator: {}", e.getMessage());
+            }
+        }
+    }
+}
