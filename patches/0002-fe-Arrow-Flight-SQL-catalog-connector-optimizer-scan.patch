+    @Override
+    public Void visitLogicalFlightScan(LogicalFlightScanOperator node, ExpressionContext context) {
+        return computeFlightScanNode(node, context, node.getTable(), node.getColRefToColumnMetaMap(),
+                node.getAggregationPushdown());
+    }
+
+    @Override
+    public Void visitPhysicalFlightScan(PhysicalFlightScanOperator node, ExpressionContext context) {
+        return computeFlightScanNode(node, context, node.getTable(), node.getColRefToColumnMetaMap(),
+                node.getAggregationPushdown());
+    }
+
+    private Void computeFlightScanNode(Operator node, ExpressionContext context, Table table,
+                                       Map<ColumnRefOperator, Column> columnRefOperatorColumnMap,
+                                       com.starrocks.connector.flight.FlightAggregationPushdown aggregation) {
+        long rowCount = Config.default_statistics_output_row_count;
+        Statistics.StatsSource source = Statistics.StatsSource.NONE;
+        try {
+            Statistics connectorStats = GlobalStateMgr.getCurrentState().getMetadataMgr().getTableStatistics(
+                    optimizerContext, table.getCatalogName(), table, columnRefOperatorColumnMap,
+                    Collections.emptyList(), null);
+            if (connectorStats != null && !Double.isNaN(connectorStats.getOutputRowCount())) {
+                rowCount = Math.max(1, (long) connectorStats.getOutputRowCount());
+                source = connectorStats.getStatsSource();
+            }
+        } catch (Exception e) {
+            LOG.warn("Failed to get Flight table statistics for {}: {}", table.getName(), e.getMessage());
+        }
+        if (aggregation != null) {
+            // partial groups returned by the server (one set per endpoint)
+            rowCount = aggregation.getGroupBy().isEmpty() ? 1 : Math.max(1, rowCount / 10);
+        }
+        return computeNormalExternalTableScanNode(node, context, table, columnRefOperatorColumnMap, rowCount, source);
+    }
+
