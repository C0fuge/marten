+package com.starrocks.connector.flight;
+
+import com.starrocks.sql.ast.expression.BinaryType;
+import com.starrocks.sql.optimizer.operator.scalar.BetweenPredicateOperator;
+import com.starrocks.sql.optimizer.operator.scalar.BinaryPredicateOperator;
+import com.starrocks.sql.optimizer.operator.scalar.CallOperator;
+import com.starrocks.sql.optimizer.operator.scalar.CastOperator;
+import com.starrocks.sql.optimizer.operator.scalar.ColumnRefOperator;
+import com.starrocks.sql.optimizer.operator.scalar.CompoundPredicateOperator;
+import com.starrocks.sql.optimizer.operator.scalar.ConstantOperator;
+import com.starrocks.sql.optimizer.operator.scalar.InPredicateOperator;
+import com.starrocks.sql.optimizer.operator.scalar.IsNullPredicateOperator;
+import com.starrocks.sql.optimizer.operator.scalar.LikePredicateOperator;
+import com.starrocks.sql.optimizer.operator.scalar.ScalarOperator;
+import com.starrocks.type.Type;
+
+import java.math.BigDecimal;
+import java.time.LocalDateTime;
+import java.time.format.DateTimeFormatter;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Map;
+import java.util.StringJoiner;
+
+/**
+ * Renders the SQL sent to the Flight SQL server (a DuckDB dialect, parsed again by the server).
+ *
+ * <p>Only constructs whose meaning is identical on both sides are rendered; anything else makes
+ * {@link #predicate} return {@code null} and that conjunct stays StarRocks-only. All conjuncts are evaluated
+ * again on the BE, so a rendered filter only has to keep every row StarRocks keeps.
+ * Identifiers are double-quoted ({@code "} doubled), strings use {@code ''} escapes, numbers are exact.
+ */
+public final class FlightSqlRenderer {
+    private static final DateTimeFormatter DATE = DateTimeFormatter.ofPattern("yyyy-MM-dd");
+    private static final DateTimeFormatter DATETIME = DateTimeFormatter.ofPattern("yyyy-MM-dd HH:mm:ss.SSSSSS");
+    private static final int MAX_IN_LIST = 10_000;
+
+    private FlightSqlRenderer() {
+    }
+
+    public static String quoteIdent(String name) {
+        return '"' + name.replace("\"", "\"\"") + '"';
+    }
+
+    public static String tableRef(String schema, String table) {
+        return quoteIdent(schema) + "." + quoteIdent(table);
+    }
+
+    public static String stringLiteral(String s) {
+        return "'" + s.replace("'", "''") + "'";
+    }
+
+    /**
+     * Columns that may appear in rendered SQL: column ref to remote column name. A column is absent when its
+     * type has no exact SQL representation (FLOAT, VARBINARY, nested, time-zoned timestamps).
+     */
+    public interface Columns {
+        String remoteName(ColumnRefOperator ref);
+    }
+
+    public static Columns columns(Map<ColumnRefOperator, String> pushable) {
+        return pushable::get;
+    }
+
+    /** Renders a boolean expression for WHERE, or returns null if it cannot be rendered exactly. */
+    public static String predicate(ScalarOperator op, Columns cols) {
+        if (op instanceof CompoundPredicateOperator) {
+            CompoundPredicateOperator c = (CompoundPredicateOperator) op;
+            List<String> parts = new ArrayList<>();
+            for (ScalarOperator child : c.getChildren()) {
+                String p = predicate(child, cols);
+                if (p == null) {
+                    return null;
+                }
+                parts.add(p);
+            }
+            switch (c.getCompoundType()) {
+                case AND:
+                    return "(" + String.join(" AND ", parts) + ")";
+                case OR:
+                    return "(" + String.join(" OR ", parts) + ")";
+                default:
+                    return "(NOT " + parts.get(0) + ")";
+            }
+        }
+        if (op instanceof BinaryPredicateOperator) {
+            BinaryPredicateOperator b = (BinaryPredicateOperator) op;
+            String l = value(b.getChild(0), cols);
+            String r = value(b.getChild(1), cols);
+            if (l == null || r == null || !comparable(b.getChild(0), b.getChild(1))) {
+                return null;
+            }
+            BinaryType t = b.getBinaryType();
+            if (t == BinaryType.EQ_FOR_NULL) {
+                return "(" + l + " IS NOT DISTINCT FROM " + r + ")";
+            }
+            String sym = t == BinaryType.NE ? "<>" : t.toString();
+            return "(" + l + " " + sym + " " + r + ")";
+        }
+        if (op instanceof InPredicateOperator) {
+            InPredicateOperator in = (InPredicateOperator) op;
+            if (in.getChildren().size() - 1 > MAX_IN_LIST) {
+                return null;
+            }
+            String l = value(in.getChild(0), cols);
+            if (l == null) {
+                return null;
+            }
+            StringJoiner list = new StringJoiner(", ", "(", ")");
+            for (int i = 1; i < in.getChildren().size(); i++) {
+                ScalarOperator v = in.getChild(i);
+                if (!(v instanceof ConstantOperator) || !comparable(in.getChild(0), v)) {
+                    return null;
+                }
+                String s = value(v, cols);
+                if (s == null) {
+                    return null;
+                }
+                list.add(s);
+            }
+            return "(" + l + (in.isNotIn() ? " NOT IN " : " IN ") + list + ")";
+        }
+        if (op instanceof IsNullPredicateOperator) {
+            IsNullPredicateOperator n = (IsNullPredicateOperator) op;
+            ScalarOperator child = n.getChild(0);
+            String l = child instanceof ColumnRefOperator ? cols.remoteName((ColumnRefOperator) child) : null;
+            if (l == null) {
+                l = value(child, cols);
+            }
+            if (l == null) {
+                return null;
+            }
+            return "(" + l + (n.isNotNull() ? " IS NOT NULL" : " IS NULL") + ")";
+        }
+        if (op instanceof BetweenPredicateOperator) {
+            BetweenPredicateOperator b = (BetweenPredicateOperator) op;
+            String v = value(b.getChild(0), cols);
+            String lo = value(b.getChild(1), cols);
+            String hi = value(b.getChild(2), cols);
+            if (v == null || lo == null || hi == null || !comparable(b.getChild(0), b.getChild(1))
+                    || !comparable(b.getChild(0), b.getChild(2))) {
+                return null;
+            }
+            return "(" + v + (b.isNotBetween() ? " NOT BETWEEN " : " BETWEEN ") + lo + " AND " + hi + ")";
+        }
+        if (op instanceof LikePredicateOperator) {
+            LikePredicateOperator like = (LikePredicateOperator) op;
+            if (like.isRegexp() || !(like.getChild(1) instanceof ConstantOperator)) {
+                return null;
+            }
+            ConstantOperator pattern = (ConstantOperator) like.getChild(1);
+            if (pattern.isNull() || !pattern.getType().isStringType()
+                    || !like.getChild(0).getType().isStringType()) {
+                return null;
+            }
+            String p = pattern.getVarchar();
+            // Backslash escapes differ (StarRocks: always on; DuckDB: only with ESCAPE): leave those to the BE.
+            if (p.indexOf('\\') >= 0) {
+                return null;
+            }
+            String l = value(like.getChild(0), cols);
+            if (l == null) {
+                return null;
+            }
+            return "(" + l + " LIKE " + stringLiteral(p) + ")";
+        }
+        if (op instanceof ConstantOperator) {
+            ConstantOperator c = (ConstantOperator) op;
+            if (c.getType().isBoolean() && !c.isNull()) {
+                return c.getBoolean() ? "TRUE" : "FALSE";
+            }
+            return null;
+        }
+        if (op instanceof ColumnRefOperator && op.getType().isBoolean()) {
+            return cols.remoteName((ColumnRefOperator) op);
+        }
+        return null;
+    }
+
+    /** Both sides have types whose comparison means the same on the server (no FLOAT, no mixed strings/numbers). */
+    private static boolean comparable(ScalarOperator a, ScalarOperator b) {
+        Type ta = a.getType();
+        Type tb = b.getType();
+        if (ta.isFloat() || tb.isFloat()) {
+            return false;
+        }
+        if (ta.isStringType() || tb.isStringType()) {
+            return ta.isStringType() && tb.isStringType();
+        }
+        if (ta.isDateType() || tb.isDateType()) {
+            return ta.isDateType() && tb.isDateType();
+        }
+        if (ta.isBoolean() || tb.isBoolean()) {
+            return ta.isBoolean() && tb.isBoolean();
+        }
+        return ta.isNumericType() && tb.isNumericType();
+    }
+
+    /** A scalar value inside a predicate: column, literal, or a widening cast of a column. */
+    private static String value(ScalarOperator op, Columns cols) {
+        if (op instanceof ColumnRefOperator) {
+            return cols.remoteName((ColumnRefOperator) op);
+        }
+        if (op instanceof ConstantOperator) {
+            return literal((ConstantOperator) op);
+        }
+        if (op instanceof CastOperator) {
+            return widenedColumn((CastOperator) op, cols);
+        }
+        return null;
+    }
+
+    /** CAST(col AS wider type) where the cast cannot change any value: integer widening, int to decimal, date. */
+    private static String widenedColumn(CastOperator cast, Columns cols) {
+        ScalarOperator child = cast.getChild(0);
+        if (!(child instanceof ColumnRefOperator)) {
+            return null;
+        }
+        String col = cols.remoteName((ColumnRefOperator) child);
+        if (col == null) {
+            return null;
+        }
+        Type from = child.getType();
+        Type to = cast.getType();
+        if (from.isIntegerType() && to.isIntegerType()
+                && to.getTypeSize() >= from.getTypeSize()) {
+            return col;
+        }
+        if ((from.isIntegerType() || from.isLargeint()) && to.isLargeint()) {
+            return col;
+        }
+        if (from.isIntegerType() && to.isDecimalOfAnyVersion()) {
+            return col;
+        }
+        if (from.isDecimalOfAnyVersion() && to.isDecimalOfAnyVersion() && isWideningDecimal(from, to)) {
+            return col;
+        }
+        if (from.isDate() && to.isDatetime()) {
+            return "CAST(" + col + " AS TIMESTAMP)";
+        }
+        return null;
+    }
+
+    private static boolean isWideningDecimal(Type from, Type to) {
+        int fs = ((com.starrocks.type.ScalarType) from).getScalarScale();
+        int fp = ((com.starrocks.type.ScalarType) from).getScalarPrecision();
+        int ts = ((com.starrocks.type.ScalarType) to).getScalarScale();
+        int tp = ((com.starrocks.type.ScalarType) to).getScalarPrecision();
+        return ts >= fs && tp - ts >= fp - fs;
+    }
+
+    /** Server SQL name of a numeric StarRocks type usable in CAST, or null. */
+    static String numericSqlType(Type t) {
+        switch (t.getPrimitiveType()) {
+            case TINYINT:
+                return "TINYINT";
+            case SMALLINT:
+                return "SMALLINT";
+            case INT:
+                return "INTEGER";
+            case BIGINT:
+                return "BIGINT";
+            case DOUBLE:
+                return "DOUBLE";
+            case DECIMAL32:
+            case DECIMAL64:
+            case DECIMAL128: {
+                com.starrocks.type.ScalarType s = (com.starrocks.type.ScalarType) t;
+                return "DECIMAL(" + s.getScalarPrecision() + "," + s.getScalarScale() + ")";
+            }
+            default:
+                return null;
+        }
+    }
+
+    /** Exact SQL literal, or null if the value has no exact representation. */
+    public static String literal(ConstantOperator c) {
+        if (c.isNull()) {
+            return "NULL";
+        }
+        Type t = c.getType();
+        switch (t.getPrimitiveType()) {
+            case BOOLEAN:
+                return c.getBoolean() ? "TRUE" : "FALSE";
+            case TINYINT:
+                return Byte.toString(c.getTinyInt());
+            case SMALLINT:
+                return Short.toString(c.getSmallint());
+            case INT:
+                return Integer.toString(c.getInt());
+            case BIGINT:
+                return Long.toString(c.getBigint());
+            case LARGEINT:
+                return c.getLargeInt().toString();
+            case DOUBLE: {
+                double d = c.getDouble();
+                if (Double.isNaN(d) || Double.isInfinite(d)) {
+                    return null;
+                }
+                // exact decimal expansion parses back to the same double
+                return new BigDecimal(d).toPlainString();
+            }
+            case DECIMALV2:
+            case DECIMAL32:
+            case DECIMAL64:
+            case DECIMAL128:
+            case DECIMAL256:
+                return c.getDecimal().toPlainString();
+            case CHAR:
+            case VARCHAR:
+                return stringLiteral(c.getVarchar());
+            case DATE:
+                return "DATE '" + c.getDate().format(DATE) + "'";
+            case DATETIME: {
+                LocalDateTime dt = c.getDatetime();
+                return "TIMESTAMP '" + dt.format(DATETIME) + "'";
+            }
+            default:
+                return null;
+        }
+    }
+
+    /**
+     * Expression inside a pushed aggregate (sum/min/max/count argument): columns, exact literals and
+     * + - * over integer/decimal/double values.
+     */
+    public static String aggregateInput(ScalarOperator op, Columns cols) {
+        if (op instanceof ColumnRefOperator) {
+            return cols.remoteName((ColumnRefOperator) op);
+        }
+        if (op instanceof ConstantOperator) {
+            ConstantOperator c = (ConstantOperator) op;
+            return c.getType().isNumericType() && !c.getType().isFloat() ? literal(c) : null;
+        }
+        if (op instanceof CastOperator) {
+            ScalarOperator child = op.getChild(0);
+            Type to = op.getType();
+            Type from = child.getType();
+            String sqlType = numericSqlType(to);
+            if (sqlType == null || !from.isNumericType() || from.isFloat()) {
+                return null;
+            }
+            // a narrowing decimal cast would round differently on the server
+            if (from.isDecimalOfAnyVersion() && to.isDecimalOfAnyVersion() && !isWideningDecimal(from, to)) {
+                return null;
+            }
+            if (from.isDecimalOfAnyVersion() && to.isIntegerType()) {
+                return null;
+            }
+            String inner = aggregateInput(child, cols);
+            return inner == null ? null : "CAST(" + inner + " AS " + sqlType + ")";
+        }
+        if (op instanceof CallOperator) {
+            CallOperator call = (CallOperator) op;
+            String fn = call.getFnName();
+            String sym;
+            switch (fn) {
+                case "add":
+                    sym = " + ";
+                    break;
+                case "subtract":
+                    sym = " - ";
+                    break;
+                case "multiply":
+                    sym = " * ";
+                    break;
+                default:
+                    return null;
+            }
+            if (call.getChildren().size() != 2 || numericSqlType(call.getType()) == null) {
+                return null;
+            }
+            String l = aggregateInput(call.getChild(0), cols);
+            String r = aggregateInput(call.getChild(1), cols);
+            if (l == null || r == null) {
+                return null;
+            }
+            return "(" + l + sym + r + ")";
+        }
+        return null;
+    }
+
+    /** One item of the remote select list. */
+    public static final class SelectItem {
+        public final String sql;
+        public final String alias;
+
+        public SelectItem(String sql, String alias) {
+            this.sql = sql;
+            this.alias = alias;
+        }
+
+        String render() {
+            return alias == null ? sql : sql + " AS " + quoteIdent(alias);
+        }
+    }
+
+    /**
+     * {@code SELECT items FROM "schema"."table" [WHERE c1 AND c2] [GROUP BY g] [LIMIT n]}.
+     */
+    public static String select(String schema, String table, List<SelectItem> items, List<String> where,
+                                List<String> groupBy, long limit, boolean forceWhere) {
+        StringBuilder sql = new StringBuilder("SELECT ");
+        if (items.isEmpty()) {
+            sql.append("1");
+        } else {
+            StringJoiner j = new StringJoiner(", ");
+            items.forEach(i -> j.add(i.render()));
+            sql.append(j);
+        }
+        sql.append(" FROM ").append(tableRef(schema, table));
+        if (!where.isEmpty()) {
+            sql.append(" WHERE ").append(String.join(" AND ", where));
+        } else if (forceWhere) {
+            sql.append(" WHERE TRUE");
+        }
+        if (!groupBy.isEmpty()) {
+            StringJoiner g = new StringJoiner(", ");
+            groupBy.forEach(c -> g.add(quoteIdent(c)));
+            sql.append(" GROUP BY ").append(g);
+        }
+        if (limit >= 0) {
+            sql.append(" LIMIT ").append(limit);
+        }
+        return sql.toString();
+    }
+}
