+package com.starrocks.connector.flight;
+
+import com.starrocks.connector.RemoteFileDesc;
+
+import java.util.List;
+
+/** The endpoints of one planned Flight SQL query (one GetFlightInfo). Each endpoint becomes one scan range. */
+public class FlightRemoteFileDesc extends RemoteFileDesc {
+    /** One FlightEndpoint: opaque ticket plus its locations in failover order (may be empty). */
+    public static final class Endpoint {
+        public final byte[] ticket;
+        public final List<String> locations;
+
+        public Endpoint(byte[] ticket, List<String> locations) {
+            this.ticket = ticket;
+            this.locations = locations;
+        }
+    }
+
+    private final List<Endpoint> endpoints;
+    private final long totalRecords;
+    private final String defaultLocation;
+
+    public FlightRemoteFileDesc(List<Endpoint> endpoints, long totalRecords, String defaultLocation) {
+        super(null, null, 0, 0, null);
+        this.endpoints = endpoints;
+        this.totalRecords = totalRecords;
+        this.defaultLocation = defaultLocation;
+    }
+
+    public List<Endpoint> getEndpoints() {
+        return endpoints;
+    }
+
+    /** Total records announced by the server, or -1. */
+    public long getTotalRecords() {
+        return totalRecords;
+    }
+
+    /** Catalog URI the planning call went to; endpoints without a location are read from there. */
+    public String getDefaultLocation() {
+        return defaultLocation;
+    }
+
+    @Override
+    public String toString() {
+        // tickets are never printed
+        return "FlightRemoteFileDesc{endpoints=" + endpoints.size() + ", totalRecords=" + totalRecords + "}";
+    }
+}
