+
+    @Test
+    public void testUnsignedIntegersAreWidened() {
+        Assertions.assertEquals(PrimitiveType.SMALLINT, map(new ArrowType.Int(8, false)).getPrimitiveType());
+        Assertions.assertEquals(PrimitiveType.INT, map(new ArrowType.Int(16, false)).getPrimitiveType());
+        Assertions.assertEquals(PrimitiveType.BIGINT, map(new ArrowType.Int(32, false)).getPrimitiveType());
+        Assertions.assertEquals(PrimitiveType.LARGEINT, map(new ArrowType.Int(64, false)).getPrimitiveType());
+    }
+
+    @Test
+    public void testDecimal() {
+        Type t = map(new ArrowType.Decimal(15, 2, 128));
+        Assertions.assertTrue(t.isDecimalOfAnyVersion());
+        Assertions.assertEquals(15, ((ScalarType) t).getScalarPrecision());
+        Assertions.assertEquals(2, ((ScalarType) t).getScalarScale());
+        Assertions.assertTrue(map(new ArrowType.Decimal(38, 10, 128)).isDecimalOfAnyVersion());
+        // Decimal256 has no BE converter
+        Assertions.assertNull(map(new ArrowType.Decimal(40, 2, 256)));
+        Assertions.assertNull(map(new ArrowType.Decimal(20, 2, 256)));
+    }
+
+    @Test
+    public void testUnsupportedTypesAreHidden() {
+        Assertions.assertNull(map(new ArrowType.Time(TimeUnit.MICROSECOND, 64)));
+        Assertions.assertNull(map(new ArrowType.Duration(TimeUnit.SECOND)));
+        Assertions.assertNull(map(ArrowType.Null.INSTANCE));
+    }
+
+    @Test
+    public void testNestedTypes() {
+        Field list = field("l", ArrowType.List.INSTANCE, field("item", new ArrowType.Int(32, true)));
+        Type nativeType = FlightTypeMapper.toStarRocksType(list, FlightProperties.NestedTypes.NATIVE);
+        Assertions.assertTrue(nativeType instanceof ArrayType);
+        Assertions.assertEquals(PrimitiveType.INT, ((ArrayType) nativeType).getItemType().getPrimitiveType());
+        Assertions.assertNull(FlightTypeMapper.toStarRocksType(list, FlightProperties.NestedTypes.HIDE));
+        Assertions.assertEquals(PrimitiveType.JSON,
+                FlightTypeMapper.toStarRocksType(list, FlightProperties.NestedTypes.JSON).getPrimitiveType());
+
+        Field entries = new Field("entries", FieldType.notNullable(ArrowType.Struct.INSTANCE), Arrays.asList(
+                new Field("key", FieldType.notNullable(ArrowType.Utf8.INSTANCE), Collections.emptyList()),
+                field("value", new ArrowType.Int(64, true))));
+        Field mapField = field("m", new ArrowType.Map(false), entries);
+        Assertions.assertTrue(FlightTypeMapper.toStarRocksType(mapField, FlightProperties.NestedTypes.NATIVE)
+                instanceof MapType);
+
+        Field struct = field("s", ArrowType.Struct.INSTANCE, field("a", ArrowType.Utf8.INSTANCE),
+                field("b", new ArrowType.Date(DateUnit.DAY)));
+        Assertions.assertTrue(FlightTypeMapper.toStarRocksType(struct, FlightProperties.NestedTypes.NATIVE)
+                instanceof StructType);
+        // a struct with an unsupported child is hidden as a whole
+        Field badStruct = field("s", ArrowType.Struct.INSTANCE, field("t", new ArrowType.Time(TimeUnit.SECOND, 32)));
+        Assertions.assertNull(FlightTypeMapper.toStarRocksType(badStruct, FlightProperties.NestedTypes.NATIVE));
+    }
+}
