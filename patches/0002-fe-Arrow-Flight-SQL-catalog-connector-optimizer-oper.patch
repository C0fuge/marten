+        @Override
+        public PlanFragment visitPhysicalFlightScan(OptExpression optExpression, ExecPlan context) {
+            PhysicalFlightScanOperator node = (PhysicalFlightScanOperator) optExpression.getOp();
+
+            Table referenceTable = node.getTable();
+            context.getDescTbl().addReferencedTable(referenceTable);
+            TupleDescriptor tupleDescriptor = context.getDescTbl().createTupleDescriptor();
+            tupleDescriptor.setTable(referenceTable);
+
+            prepareContextSlots(node, context, tupleDescriptor);
+
+            FlightScanNode flightScanNode =
+                    new FlightScanNode(context.getNextNodeId(), tupleDescriptor, "FlightScanNode");
+            flightScanNode.setScanOptimizeOption(node.getScanOptimizeOption());
+            ScalarOperatorToExpr.FormatterContext formatterContext =
+                    new ScalarOperatorToExpr.FormatterContext(context.getColRefToExpr());
+            for (ScalarOperator predicate : Utils.extractConjuncts(node.getPredicate())) {
+                flightScanNode.getConjuncts().add(ScalarOperatorToExpr.buildExecExpression(predicate, formatterContext));
+            }
+            try {
+                flightScanNode.setupScanRangeLocations(node.getColRefToColumnMetaMap(), node.getPredicate(),
+                        node.getLimit(), node.getAggregationPushdown());
+            } catch (StarRocksConnectorException e) {
+                throw new StarRocksPlannerException(e.getMessage(), INTERNAL_ERROR);
+            }
+            flightScanNode.setLimit(node.getLimit());
+
+            tupleDescriptor.computeMemLayout();
+            context.getScanNodes().add(flightScanNode);
+
+            PlanFragment fragment =
+                    new PlanFragment(context.getNextFragmentId(), flightScanNode, DataPartition.RANDOM);
+            context.getFragments().add(fragment);
+            return fragment;
+        }
