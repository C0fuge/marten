+// limitations under the License.
+
+package com.starrocks.connector.flight;
+
+import com.google.common.base.Splitter;
+import com.google.common.collect.ImmutableList;
+import com.google.common.collect.ImmutableMap;
+import com.google.common.collect.ImmutableSet;
+import com.starrocks.connector.exception.StarRocksConnectorException;
+
+import java.io.IOException;
+import java.net.URI;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+import java.util.Set;
+
+/**
+ * Validated properties of an Arrow Flight SQL catalog ({@code "type" = "flight"}).
+ */
+public final class FlightProperties {
+    public static final String URI = "flight.uri";
+    public static final String TOKEN = "flight.token";
+    public static final String USER = "flight.user";
+    public static final String PASSWORD = "flight.password";
+    public static final String TLS_VERIFY = "flight.tls.verify";
+    public static final String TLS_CA_FILE = "flight.tls.ca_file";
+    public static final String TLS_OVERRIDE_HOSTNAME = "flight.tls.override_hostname";
+    public static final String RESULT_MODE = "flight.result_mode";
+    public static final String LOCATION_FAILOVER = "flight.location_failover";
+    public static final String HEADER_PREFIX = "flight.header.";
+    public static final String CONNECT_TIMEOUT_MS = "flight.connect_timeout_ms";
+    public static final String KEEPALIVE_MS = "flight.keepalive_ms";
+    public static final String RPC_TIMEOUT_MS = "flight.rpc_timeout_ms";
+    public static final String CATALOG = "flight.catalog";
+    public static final String NESTED_TYPES = "flight.nested_types";
+    public static final String PUSHDOWN_FILTER = "flight.pushdown.filter";
+    public static final String PUSHDOWN_LIMIT = "flight.pushdown.limit";
+    public static final String PUSHDOWN_AGGREGATE = "flight.pushdown.aggregate";
+    public static final String METADATA_CACHE_TTL_S = "flight.metadata_cache_ttl_s";
+    public static final String STATS_CACHE_TTL_S = "flight.stats_cache_ttl_s";
+
+    /** Property keys whose values are secrets (masked in SHOW CREATE CATALOG, logs and the audit log). */
+    public static final Set<String> SENSITIVE_KEYS = ImmutableSet.of(TOKEN, PASSWORD);
+
+    public static final String HEADER_RESULT_MODE = "x-flight-result-mode";
+    public static final String HEADER_LOCATION_FAILOVER = "x-flight-location-failover";
+
+    public enum NestedTypes { NATIVE, JSON, HIDE }
+
+    private static final Set<String> KNOWN = ImmutableSet.of(URI, TOKEN, USER, PASSWORD, TLS_VERIFY, TLS_CA_FILE,
+            TLS_OVERRIDE_HOSTNAME, RESULT_MODE, LOCATION_FAILOVER, CONNECT_TIMEOUT_MS, KEEPALIVE_MS, RPC_TIMEOUT_MS,
+            CATALOG, NESTED_TYPES, PUSHDOWN_FILTER, PUSHDOWN_LIMIT, PUSHDOWN_AGGREGATE, METADATA_CACHE_TTL_S,
+            STATS_CACHE_TTL_S, "type");
+
+    private final List<URI> uris;
+    private final String token;
+    private final String user;
+    private final String password;
+    private final boolean tlsVerify;
+    private final String tlsRootCerts;
+    private final String tlsOverrideHostname;
+    private final String resultMode;
+    private final boolean locationFailover;
+    private final Map<String, String> extraHeaders;
+    private final int connectTimeoutMs;
+    private final int keepaliveMs;
+    private final long rpcTimeoutMs;
+    private final String flightCatalog;
+    private final NestedTypes nestedTypes;
+    private final boolean filterPushdown;
+    private final boolean limitPushdown;
+    private final boolean aggregatePushdown;
+    private final long metadataCacheTtlSec;
+    private final long statsCacheTtlSec;
+
+    public FlightProperties(Map<String, String> props) {
+        String uriList = props.get(URI);
+        if (uriList == null || uriList.isBlank()) {
+            throw new StarRocksConnectorException("The property %s must be set.", URI);
+        }
+        ImmutableList.Builder<URI> parsed = ImmutableList.builder();
+        for (String u : Splitter.on(',').trimResults().omitEmptyStrings().split(uriList)) {
+            URI uri;
+            try {
+                uri = new URI(u);
+            } catch (Exception e) {
+                throw new StarRocksConnectorException("Invalid %s: %s", URI, u);
+            }
+            String scheme = uri.getScheme() == null ? "" : uri.getScheme().toLowerCase(Locale.ROOT);
+            if (!scheme.equals("grpc") && !scheme.equals("grpc+tcp") && !scheme.equals("grpc+tls")) {
+                throw new StarRocksConnectorException("%s must use grpc://, grpc+tcp:// or grpc+tls://, got: %s",
+                        URI, u);
+            }
+            if (uri.getHost() == null || uri.getPort() <= 0) {
+                throw new StarRocksConnectorException("%s needs host and port: %s", URI, u);
+            }
+            parsed.add(uri);
+        }
+        this.uris = parsed.build();
+        if (uris.isEmpty()) {
+            throw new StarRocksConnectorException("The property %s must be set.", URI);
+        }
+        this.token = emptyToNull(props.get(TOKEN));
+        this.user = emptyToNull(props.get(USER));
+        this.password = props.get(PASSWORD);
+        if (token != null && user != null) {
+            throw new StarRocksConnectorException("Set either %s or %s/%s, not both.", TOKEN, USER, PASSWORD);
+        }
+        this.tlsVerify = parseBool(props, TLS_VERIFY, true);
+        this.tlsRootCerts = readCa(props.get(TLS_CA_FILE));
+        this.tlsOverrideHostname = emptyToNull(props.get(TLS_OVERRIDE_HOSTNAME));
+        this.resultMode = props.getOrDefault(RESULT_MODE, "partial").trim().toLowerCase(Locale.ROOT);
+        if (!resultMode.equals("partial") && !resultMode.equals("complete") && !resultMode.equals("server")) {
+            throw new StarRocksConnectorException("%s must be partial, complete or server, got: %s",
+                    RESULT_MODE, resultMode);
+        }
+        this.locationFailover = parseBool(props, LOCATION_FAILOVER, true);
+        ImmutableMap.Builder<String, String> headers = ImmutableMap.builder();
+        for (Map.Entry<String, String> e : props.entrySet()) {
+            if (e.getKey().startsWith(HEADER_PREFIX)) {
+                String name = e.getKey().substring(HEADER_PREFIX.length()).toLowerCase(Locale.ROOT);
+                if (name.isEmpty() || name.equals("authorization")) {
+                    throw new StarRocksConnectorException("Invalid header property %s", e.getKey());
+                }
+                headers.put(name, e.getValue());
+            } else if (e.getKey().startsWith("flight.") && !KNOWN.contains(e.getKey())) {
+                throw new StarRocksConnectorException("Unknown property %s for a flight catalog", e.getKey());
+            }
+        }
+        this.extraHeaders = headers.build();
+        this.connectTimeoutMs = (int) parseLong(props, CONNECT_TIMEOUT_MS, 5000, 1, 600_000);
+        this.keepaliveMs = (int) parseLong(props, KEEPALIVE_MS, 10_000, 0, 3_600_000);
+        this.rpcTimeoutMs = parseLong(props, RPC_TIMEOUT_MS, 0, 0, Long.MAX_VALUE);
+        this.flightCatalog = emptyToNull(props.get(CATALOG));
+        String nested = props.getOrDefault(NESTED_TYPES, "native").trim().toUpperCase(Locale.ROOT);
+        try {
+            this.nestedTypes = NestedTypes.valueOf(nested);
+        } catch (IllegalArgumentException e) {
+            throw new StarRocksConnectorException("%s must be native, json or hide, got: %s", NESTED_TYPES,
+                    props.get(NESTED_TYPES));
+        }
+        this.filterPushdown = parseBool(props, PUSHDOWN_FILTER, true);
+        this.limitPushdown = parseBool(props, PUSHDOWN_LIMIT, true);
+        this.aggregatePushdown = parseBool(props, PUSHDOWN_AGGREGATE, true);
+        this.metadataCacheTtlSec = parseLong(props, METADATA_CACHE_TTL_S, 60, 0, 86_400 * 30L);
+        this.statsCacheTtlSec = parseLong(props, STATS_CACHE_TTL_S, 600, 0, 86_400 * 30L);
+    }
+
+    private static String emptyToNull(String s) {
+        return s == null || s.isEmpty() ? null : s;
+    }
+
+    private static boolean parseBool(Map<String, String> props, String key, boolean def) {
+        String v = props.get(key);
+        if (v == null) {
+            return def;
+        }
+        v = v.trim().toLowerCase(Locale.ROOT);
+        if (v.equals("true") || v.equals("1") || v.equals("yes") || v.equals("on")) {
+            return true;
+        }
+        if (v.equals("false") || v.equals("0") || v.equals("no") || v.equals("off")) {
+            return false;
+        }
+        throw new StarRocksConnectorException("%s must be true or false, got: %s", key, props.get(key));
+    }
+
+    private static long parseLong(Map<String, String> props, String key, long def, long min, long max) {
+        String v = props.get(key);
+        if (v == null) {
+            return def;
+        }
+        try {
+            long l = Long.parseLong(v.trim());
+            if (l < min || l > max) {
+                throw new NumberFormatException();
+            }
+            return l;
+        } catch (NumberFormatException e) {
+            throw new StarRocksConnectorException("%s must be an integer in [%d, %d], got: %s", key, min, max, v);
+        }
+    }
+
+    /** Accepts a path to a PEM file or inline PEM content. */
+    private static String readCa(String value) {
+        if (value == null || value.isBlank()) {
+            return null;
+        }
+        if (value.contains("-----BEGIN")) {
+            return value;
+        }
+        try {
+            return Files.readString(Path.of(value.trim()), StandardCharsets.US_ASCII);
+        } catch (IOException e) {
+            throw new StarRocksConnectorException("Cannot read %s %s: %s", TLS_CA_FILE, value, e.getMessage());
+        }
+    }
+
+    public List<URI> getUris() {
+        return uris;
+    }
+
+    /** Location string of the first catalog URI (default location for endpoints without locations). */
+    public String getDefaultLocation() {
+        return uris.get(0).toString();
+    }
+
+    public String getToken() {
+        return token;
+    }
+
+    public String getUser() {
+        return user;
+    }
+
+    public String getPassword() {
+        return password;
+    }
+
+    public boolean isTlsVerify() {
+        return tlsVerify;
+    }
+
+    public String getTlsRootCerts() {
+        return tlsRootCerts;
+    }
+
+    public String getTlsOverrideHostname() {
+        return tlsOverrideHostname;
+    }
+
+    public String getResultMode() {
+        return resultMode;
+    }
+
+    public boolean isLocationFailover() {
+        return locationFailover;
+    }
+
+    /** Headers sent with every Flight call (except authorization). */
+    public Map<String, String> getCallHeaders() {
+        ImmutableMap.Builder<String, String> b = ImmutableMap.builder();
+        if (!resultMode.equals("server")) {
+            b.put(HEADER_RESULT_MODE, resultMode);
+        }
+        if (locationFailover) {
+            b.put(HEADER_LOCATION_FAILOVER, "1");
+        }
+        extraHeaders.forEach((k, v) -> {
+            if (!k.equals(HEADER_RESULT_MODE) && !k.equals(HEADER_LOCATION_FAILOVER)) {
+                b.put(k, v);
+            }
+        });
+        return b.build();
+    }
+
+    public int getConnectTimeoutMs() {
+        return connectTimeoutMs;
+    }
+
+    public int getKeepaliveMs() {
+        return keepaliveMs;
+    }
+
+    public long getRpcTimeoutMs() {
+        return rpcTimeoutMs;
+    }
+
+    public String getFlightCatalog() {
+        return flightCatalog;
+    }
+
+    public NestedTypes getNestedTypes() {
+        return nestedTypes;
+    }
+
+    public boolean isFilterPushdown() {
+        return filterPushdown;
+    }
+
+    public boolean isLimitPushdown() {
+        return limitPushdown;
+    }
+
+    public boolean isAggregatePushdown() {
+        return aggregatePushdown;
+    }
+
+    public long getMetadataCacheTtlSec() {
+        return metadataCacheTtlSec;
+    }
+
+    public long getStatsCacheTtlSec() {
+        return statsCacheTtlSec;
+    }
+
+    public boolean isTls() {
+        return uris.get(0).getScheme().equalsIgnoreCase("grpc+tls");
+    }
+}
