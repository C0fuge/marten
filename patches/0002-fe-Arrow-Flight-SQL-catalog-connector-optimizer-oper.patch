+package com.starrocks.connector.flight;
+
+import com.google.common.collect.ImmutableList;
+import com.google.common.collect.ImmutableMap;
+
+import java.util.List;
+import java.util.Map;
+import java.util.Objects;
+
+/**
+ * A partial aggregation computed by the Flight SQL server for every endpoint:
+ * {@code SELECT g..., agg(...) AS "c"... FROM t WHERE ... GROUP BY g...}. StarRocks merges the partial
+ * results with a second aggregation (sum of counts and sums, min of mins, max of maxes).
+ */
+public final class FlightAggregationPushdown {
+    /** Remote names of the GROUP BY columns. */
+    private final List<String> groupBy;
+    /** Synthetic output column name to the rendered partial aggregate (e.g. {@code sum("x")}). */
+    private final Map<String, String> aggregates;
+    /** Rendered conjuncts; every conjunct of the original scan predicate, so the scan has no predicate left. */
+    private final List<String> where;
+
+    public FlightAggregationPushdown(List<String> groupBy, Map<String, String> aggregates, List<String> where) {
+        this.groupBy = ImmutableList.copyOf(groupBy);
+        this.aggregates = ImmutableMap.copyOf(aggregates);
+        this.where = ImmutableList.copyOf(where);
+    }
+
+    public List<String> getGroupBy() {
+        return groupBy;
+    }
+
+    public Map<String, String> getAggregates() {
+        return aggregates;
+    }
+
+    public List<String> getWhere() {
+        return where;
+    }
+
+    /** Synthetic column names start with this prefix (they never clash with remote names in practice). */
+    public static final String SYNTHETIC_PREFIX = "__flight_agg_";
+
+    public static boolean isSynthetic(String name) {
+        return name.startsWith(SYNTHETIC_PREFIX);
+    }
+
+    @Override
+    public boolean equals(Object o) {
+        if (this == o) {
+            return true;
+        }
+        if (!(o instanceof FlightAggregationPushdown)) {
+            return false;
+        }
+        FlightAggregationPushdown that = (FlightAggregationPushdown) o;
+        return groupBy.equals(that.groupBy) && aggregates.equals(that.aggregates) && where.equals(that.where);
+    }
+
+    @Override
+    public int hashCode() {
+        return Objects.hash(groupBy, aggregates, where);
+    }
+
+    @Override
+    public String toString() {
+        return "groupBy=" + groupBy + ", aggregates=" + aggregates.values() + ", where=" + where;
+    }
+}
