+import com.starrocks.sql.optimizer.operator.scalar.ScalarOperator;
+
+import java.util.Map;
+import java.util.Objects;
+
+public class LogicalFlightScanOperator extends LogicalScanOperator {
+    /** Partial aggregation computed by the server, or null for a plain scan. */
+    private FlightAggregationPushdown aggregationPushdown;
+
+    public LogicalFlightScanOperator(Table table,
+                                     Map<ColumnRefOperator, Column> colRefToColumnMetaMap,
+                                     Map<Column, ColumnRefOperator> columnMetaToColRefMap,
+                                     long limit, ScalarOperator predicate) {
+        super(OperatorType.LOGICAL_FLIGHT_SCAN, table, colRefToColumnMetaMap, columnMetaToColRefMap, limit,
+                predicate, null);
+        Preconditions.checkState(table instanceof FlightTable);
+    }
+
+    private LogicalFlightScanOperator() {
+        super(OperatorType.LOGICAL_FLIGHT_SCAN);
+    }
+
+    public FlightAggregationPushdown getAggregationPushdown() {
+        return aggregationPushdown;
+    }
+
+    public void setAggregationPushdown(FlightAggregationPushdown aggregationPushdown) {
+        this.aggregationPushdown = aggregationPushdown;
+    }
+
+    @Override
+    public <R, C> R accept(OperatorVisitor<R, C> visitor, C context) {
+        return visitor.visitLogicalFlightScan(this, context);
+    }
+
+    @Override
+    public boolean equals(Object o) {
+        if (!super.equals(o)) {
+            return false;
+        }
+        return Objects.equals(aggregationPushdown, ((LogicalFlightScanOperator) o).aggregationPushdown);
+    }
+
+    @Override
+    public int hashCode() {
+        return Objects.hash(super.hashCode(), aggregationPushdown);
+    }
+
+    public static class Builder
+            extends LogicalScanOperator.Builder<LogicalFlightScanOperator, LogicalFlightScanOperator.Builder> {
+
+        @Override
+        protected LogicalFlightScanOperator newInstance() {
+            return new LogicalFlightScanOperator();
+        }
+
+        @Override
+        public LogicalFlightScanOperator.Builder withOperator(LogicalFlightScanOperator scanOperator) {
+            super.withOperator(scanOperator);
+            builder.aggregationPushdown = scanOperator.aggregationPushdown;
+            return this;
+        }
