+
+import java.util.Objects;
+
+public class PhysicalFlightScanOperator extends PhysicalScanOperator {
+    private final FlightAggregationPushdown aggregationPushdown;
+
+    public PhysicalFlightScanOperator(LogicalFlightScanOperator scan) {
+        super(OperatorType.PHYSICAL_FLIGHT_SCAN, scan);
+        this.aggregationPushdown = scan.getAggregationPushdown();
+    }
+
+    public FlightAggregationPushdown getAggregationPushdown() {
+        return aggregationPushdown;
+    }
+
+    @Override
+    public <R, C> R accept(OperatorVisitor<R, C> visitor, C context) {
+        return visitor.visitPhysicalFlightScan(this, context);
+    }
+
+    @Override
+    public <R, C> R accept(OptExpressionVisitor<R, C> visitor, OptExpression optExpression, C context) {
+        return visitor.visitPhysicalFlightScan(optExpression, context);
+    }
+
+    @Override
+    public boolean equals(Object o) {
+        if (!super.equals(o)) {
+            return false;
+        }
+        return Objects.equals(aggregationPushdown, ((PhysicalFlightScanOperator) o).aggregationPushdown);
+    }
+
+    @Override
+    public int hashCode() {
+        return Objects.hash(super.hashCode(), aggregationPushdown);
+    }
+}
