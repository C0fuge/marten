+
+    @Test
+    public void testScalarTypes() {
+        Assertions.assertEquals(PrimitiveType.BOOLEAN, map(ArrowType.Bool.INSTANCE).getPrimitiveType());
+        Assertions.assertEquals(PrimitiveType.TINYINT, map(new ArrowType.Int(8, true)).getPrimitiveType());
