+        Assertions.assertEquals(PrimitiveType.VARBINARY, map(ArrowType.Binary.INSTANCE).getPrimitiveType());
+        Assertions.assertEquals(PrimitiveType.DATE, map(new ArrowType.Date(DateUnit.DAY)).getPrimitiveType());
