+package com.starrocks.connector.flight;
+
+import com.google.common.collect.ImmutableMap;
+import com.starrocks.common.util.PrintableMap;
+import com.starrocks.common.util.SqlCredentialRedactor;
+import com.starrocks.connector.exception.StarRocksConnectorException;
+import com.starrocks.credential.CredentialUtil;
+import org.junit.jupiter.api.Assertions;
+import org.junit.jupiter.api.Test;
+
+import java.util.HashMap;
+import java.util.Map;
+
+public class FlightPropertiesTest {
+    private static FlightProperties props(String... kv) {
+        Map<String, String> m = new HashMap<>();
+        m.put("type", "flight");
+        for (int i = 0; i < kv.length; i += 2) {
+            m.put(kv[i], kv[i + 1]);
+        }
+        return new FlightProperties(m);
+    }
+
+    @Test
+    public void testDefaults() {
+        FlightProperties p = props("flight.uri", "grpc://h1:8815");
+        Assertions.assertEquals("grpc://h1:8815", p.getDefaultLocation());
+        Assertions.assertEquals("partial", p.getResultMode());
+        Assertions.assertTrue(p.isLocationFailover());
+        Assertions.assertTrue(p.isTlsVerify());
+        Assertions.assertFalse(p.isTls());
+        Assertions.assertEquals(5000, p.getConnectTimeoutMs());
+        Assertions.assertEquals(10000, p.getKeepaliveMs());
+        Assertions.assertEquals(FlightProperties.NestedTypes.NATIVE, p.getNestedTypes());
+        Assertions.assertTrue(p.isFilterPushdown());
+        Assertions.assertTrue(p.isLimitPushdown());
+        Assertions.assertEquals(ImmutableMap.of("x-flight-result-mode", "partial", "x-flight-location-failover", "1"),
+                p.getCallHeaders());
+    }
+
+    @Test
+    public void testUrisAndHeaders() {
+        FlightProperties p = props("flight.uri", "grpc+tls://a:1, grpc+tls://b:2", "flight.header.X-Tenant", "t1",
+                "flight.result_mode", "complete", "flight.location_failover", "false");
+        Assertions.assertEquals(2, p.getUris().size());
+        Assertions.assertTrue(p.isTls());
+        Assertions.assertEquals(ImmutableMap.of("x-flight-result-mode", "complete", "x-tenant", "t1"),
+                p.getCallHeaders());
+    }
+
+    @Test
+    public void testInvalid() {
+        Assertions.assertThrows(StarRocksConnectorException.class, () -> props());
+        Assertions.assertThrows(StarRocksConnectorException.class, () -> props("flight.uri", "http://h:1"));
+        Assertions.assertThrows(StarRocksConnectorException.class, () -> props("flight.uri", "grpc://h"));
+        Assertions.assertThrows(StarRocksConnectorException.class,
+                () -> props("flight.uri", "grpc://h:1", "flight.token", "t", "flight.user", "u"));
+        Assertions.assertThrows(StarRocksConnectorException.class,
+                () -> props("flight.uri", "grpc://h:1", "flight.unknown", "x"));
+        Assertions.assertThrows(StarRocksConnectorException.class,
+                () -> props("flight.uri", "grpc://h:1", "flight.header.authorization", "x"));
+        Assertions.assertThrows(StarRocksConnectorException.class,
+                () -> props("flight.uri", "grpc://h:1", "flight.result_mode", "bogus"));
+        Assertions.assertThrows(StarRocksConnectorException.class,
+                () -> props("flight.uri", "grpc://h:1", "flight.connect_timeout_ms", "-5"));
+    }
+
+    @Test
+    public void testSecretsAreMasked() {
+        Map<String, String> m = new HashMap<>();
+        m.put("type", "flight");
+        m.put("flight.uri", "grpc://h:1");
+        m.put("flight.token", "secret-token-value");
+        m.put("flight.password", "secret-password");
+
+        String printed = new PrintableMap<>(m, "=", true, false, true).toString();
+        Assertions.assertFalse(printed.contains("secret"), printed);
+
+        Map<String, String> copy = new HashMap<>(m);
+        CredentialUtil.maskCredential(copy);
+        Assertions.assertFalse(copy.get("flight.token").contains("secret"));
+        Assertions.assertFalse(copy.get("flight.password").contains("secret"));
+        Assertions.assertEquals("grpc://h:1", copy.get("flight.uri"));
+
+        String sql = "CREATE EXTERNAL CATALOG f PROPERTIES (\"type\"=\"flight\", \"flight.uri\"=\"grpc://h:1\", "
+                + "\"flight.token\"=\"secret-token-value\", \"flight.password\"=\"secret-password\")";
+        String redacted = SqlCredentialRedactor.redact(sql);
+        Assertions.assertFalse(redacted.contains("secret"), redacted);
+        Assertions.assertTrue(redacted.contains("grpc://h:1"), redacted);
+    }
+}
