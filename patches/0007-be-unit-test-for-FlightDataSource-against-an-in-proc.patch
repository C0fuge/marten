+TEST_F(FlightConnectorTest, ConnectTimeoutFailsOverFromSilentLocation) {
+    create_state(int_slots());
+    SilentListener silent;
+    auto source = create_source("ints:10:1", {"grpc://127.0.0.1:" + std::to_string(silent.port), _uri});
+    // safety net: a connect that never times out is cancelled after 30 s instead of hanging the test
+    std::atomic<bool> done{false};
+    std::thread guard([&] {
+        auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds(30);
+        while (!done && std::chrono::steady_clock::now() < deadline) {
+            std::this_thread::sleep_for(std::chrono::milliseconds(50));
+        }
+        if (!done) {
+            _state->set_is_cancelled(true);
+        }
+    });
+    auto start = std::chrono::steady_clock::now();
+    Status st = source->open(_state);
+    auto elapsed_ms =
+            std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now() - start).count();
+    done = true;
+    guard.join();
+    LOG(INFO) << "open with a silent first location took " << elapsed_ms << " ms: " << st;
+    ASSERT_OK(st);
+    std::vector<ChunkPtr> chunks;
+    ASSERT_OK(read_all(source.get(), &chunks));
+    source->close(_state);
+    EXPECT_EQ(1, failover_count());
+    EXPECT_LT(elapsed_ms, 10000);
+}
