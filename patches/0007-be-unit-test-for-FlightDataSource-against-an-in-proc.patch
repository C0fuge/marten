+TEST_F(FlightConnectorTest, CancelWakesBlockedRead) {
+    create_state(int_slots());
+    auto source = create_source("block");
+    ASSERT_OK(source->open(_state));
+    ChunkPtr chunk;
+    ASSERT_OK(source->get_next(_state, &chunk));
+    EXPECT_EQ(3, chunk->num_rows());
+
+    std::thread canceller([&] {
+        std::this_thread::sleep_for(std::chrono::milliseconds(300));
+        _state->set_is_cancelled(true);
+    });
+    auto start = std::chrono::steady_clock::now();
+    Status st = source->get_next(_state, &chunk);
+    auto elapsed_ms =
+            std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now() - start).count();
+    canceller.join();
+    source->close(_state);
+    EXPECT_TRUE(st.is_cancelled()) << st;
+    // watcher period 200 ms + the 300 ms delay; the server would stall for 20 s
+    EXPECT_LT(elapsed_ms, 3000);
+}
