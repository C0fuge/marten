+TEST_F(FlightConnectorTest, EvaluatesConjuncts) {
+    create_state(int_slots());
+    std::vector<TExpr> texprs{ExprsTestHelper::create_binary_pred_texpr<TYPE_INT, int>(0, 25)}; // c0 > 25
+    std::vector<ExprContext*> conjuncts;
+    ASSERT_OK(ExprsTestHelper::create_and_open_conjunct_ctxs(&_pool, _state, &texprs, &conjuncts));
+    auto source = create_source("ints:10:3");
+    source->set_predicates(conjuncts);
+    ASSERT_OK(source->open(_state));
+    std::vector<ChunkPtr> chunks;
+    ASSERT_OK(read_all(source.get(), &chunks));
+    source->close(_state);
+    std::vector<int32_t> values;
+    for (const auto& c : chunks) {
+        for (size_t i = 0; i < c->num_rows(); i++) {
+            values.push_back(c->get_column_by_slot_id(0)->get(i).get_int32());
+        }
+    }
+    EXPECT_EQ((std::vector<int32_t>{26, 27, 28, 29}), values);
+    EXPECT_EQ(30, source->raw_rows_read());
+    EXPECT_EQ(4, source->num_rows_read());
+    Expr::close(conjuncts, _state);
+}
