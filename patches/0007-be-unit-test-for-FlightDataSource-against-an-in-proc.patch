+TEST_F(FlightConnectorTest, SlicesLargeBatchesIntoChunks) {
+    create_state(int_slots(), 1000);
+    auto source = create_source("ints:2500:2");
+    ASSERT_OK(source->open(_state));
+    std::vector<ChunkPtr> chunks;
+    ASSERT_OK(read_all(source.get(), &chunks));
+    source->close(_state);
+    std::vector<size_t> sizes;
+    int64_t sum = 0;
+    for (const auto& c : chunks) {
+        sizes.push_back(c->num_rows());
+        for (size_t i = 0; i < c->num_rows(); i++) {
+            sum += c->get_column_by_slot_id(0)->get(i).get_int32();
+        }
+    }
+    EXPECT_EQ((std::vector<size_t>{1000, 1000, 500, 1000, 1000, 500}), sizes);
+    EXPECT_EQ(int64_t(4999) * 5000 / 2, sum);
+}
