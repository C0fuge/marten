+// A self-signed certificate (EC P-256, CA:TRUE, valid for a day) for the DNS name `host`, and its key.
+fl::CertKeyPair self_signed_cert(const std::string& host) {
+    EVP_PKEY_CTX* pctx = EVP_PKEY_CTX_new_id(EVP_PKEY_EC, nullptr);
+    CHECK(pctx != nullptr);
+    CHECK_EQ(1, EVP_PKEY_keygen_init(pctx));
+    CHECK_EQ(1, EVP_PKEY_CTX_set_ec_paramgen_curve_nid(pctx, NID_X9_62_prime256v1));
+    EVP_PKEY* pkey = nullptr;
+    CHECK_EQ(1, EVP_PKEY_keygen(pctx, &pkey));
+    EVP_PKEY_CTX_free(pctx);
+
+    X509* x509 = X509_new();
+    CHECK_EQ(1, X509_set_version(x509, 2));
+    ASN1_INTEGER_set(X509_get_serialNumber(x509), 1);
+    X509_gmtime_adj(X509_getm_notBefore(x509), -3600);
+    X509_gmtime_adj(X509_getm_notAfter(x509), 86400);
+    CHECK_EQ(1, X509_set_pubkey(x509, pkey));
+    X509_NAME* name = X509_get_subject_name(x509);
+    CHECK_EQ(1, X509_NAME_add_entry_by_txt(name, "CN", MBSTRING_ASC,
+                                           reinterpret_cast<const unsigned char*>(host.c_str()), -1, -1, 0));
+    CHECK_EQ(1, X509_set_issuer_name(x509, name));
+    X509V3_CTX ctx;
+    X509V3_set_ctx_nodb(&ctx);
+    X509V3_set_ctx(&ctx, x509, x509, nullptr, nullptr, 0);
+    const std::string san = "DNS:" + host;
+    for (const auto& [nid, value] :
+         std::vector<std::pair<int, std::string>>{{NID_basic_constraints, "critical,CA:TRUE"},
+                                                  {NID_subject_alt_name, san}}) {
+        X509_EXTENSION* ext = X509V3_EXT_conf_nid(nullptr, &ctx, nid, value.c_str());
+        CHECK(ext != nullptr);
+        CHECK_EQ(1, X509_add_ext(x509, ext, -1));
+        X509_EXTENSION_free(ext);
+    }
+    CHECK_GT(X509_sign(x509, pkey, EVP_sha256()), 0);
+
+    auto to_pem = [](const std::function<int(BIO*)>& write) {
+        BIO* bio = BIO_new(BIO_s_mem());
+        CHECK_EQ(1, write(bio));
+        char* data = nullptr;
+        long len = BIO_get_mem_data(bio, &data);
+        std::string pem(data, len);
+        BIO_free(bio);
+        return pem;
+    };
+    fl::CertKeyPair pair;
+    pair.pem_cert = to_pem([&](BIO* bio) { return PEM_write_bio_X509(bio, x509); });
+    pair.pem_key = to_pem(
+            [&](BIO* bio) { return PEM_write_bio_PrivateKey(bio, pkey, nullptr, nullptr, 0, nullptr, nullptr); });
+    X509_free(x509);
+    EVP_PKEY_free(pkey);
+    return pair;
+}
