+constexpr const char* kToken = "test-token";
+constexpr const char* kUser = "flight-user";
+constexpr const char* kPassword = "flight-password";
+
+std::shared_ptr<arrow::Array> finish(arrow::ArrayBuilder* builder) {
+    std::shared_ptr<arrow::Array> array;
+    EXPECT_TRUE(builder->Finish(&array).ok());
+    return array;
+}
+
+// one int32 column "c0" with the values start, start+1, ...
+std::shared_ptr<arrow::RecordBatch> int_batch(int start, int rows) {
+    arrow::Int32Builder b;
+    for (int i = 0; i < rows; i++) {
+        EXPECT_TRUE(b.Append(start + i).ok());
+    }
+    auto schema = arrow::schema({arrow::field("c0", arrow::int32())});
+    return arrow::RecordBatch::Make(schema, rows, {finish(&b)});
+}
+
+// Delivers its batches, then blocks (up to 20 s) until released: a server that stops sending mid-stream.
+class BlockingReader final : public arrow::RecordBatchReader {
+public:
+    BlockingReader(std::shared_ptr<arrow::RecordBatch> first, std::atomic<bool>* release)
+            : _first(std::move(first)), _release(release) {}
+    std::shared_ptr<arrow::Schema> schema() const override { return _first->schema(); }
+    arrow::Status ReadNext(std::shared_ptr<arrow::RecordBatch>* batch) override {
+        if (_first != nullptr && !_sent) {
+            _sent = true;
+            *batch = _first;
+            return arrow::Status::OK();
+        }
+        auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds(20);
+        while (!_release->load() && std::chrono::steady_clock::now() < deadline) {
+            std::this_thread::sleep_for(std::chrono::milliseconds(20));
+        }
+        *batch = nullptr;
+        return arrow::Status::OK();
+    }
+
+private:
+    std::shared_ptr<arrow::RecordBatch> _first;
+    std::atomic<bool>* _release;
+    bool _sent = false;
+};
+
+// Basic auth as AuthenticateBasicToken does it: the Handshake carries "authorization: Basic base64(user:password)",
+// the server answers with "authorization: Bearer <token>" (used by DoGet). Any other Basic header is rejected.
+class BearerMiddleware final : public fl::ServerMiddleware {
+public:
+    std::string name() const override { return "bearer"; }
+    void SendingHeaders(fl::AddCallHeaders* outgoing_headers) override {
+        outgoing_headers->AddHeader("authorization", std::string("Bearer ") + kToken);
+    }
+    void CallCompleted(const arrow::Status&) override {}
+};
+
+class BasicAuthMiddlewareFactory final : public fl::ServerMiddlewareFactory {
+public:
+    arrow::Status StartCall(const fl::CallInfo& info, const fl::ServerCallContext& context,
+                            std::shared_ptr<fl::ServerMiddleware>* middleware) override {
+        for (const auto& [k, v] : context.incoming_headers()) {
+            if (k != "authorization" || v.rfind("Basic ", 0) != 0) {
+                continue;
+            }
+            if (arrow::util::base64_decode(v.substr(6)) != std::string(kUser) + ":" + kPassword) {
+                return fl::MakeFlightError(fl::FlightStatusCode::Unauthenticated, "bad credentials");
+            }
+            if (info.method == fl::FlightMethod::Handshake) {
+                num_handshake++;
+            }
+            *middleware = std::make_shared<BearerMiddleware>();
+        }
+        return arrow::Status::OK();
+    }
+
+    std::atomic<int> num_handshake{0};
+};
