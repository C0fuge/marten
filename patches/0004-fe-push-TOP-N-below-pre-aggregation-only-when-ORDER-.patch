From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: starrocks-flight <starrocks-flight@localhost>
Date: Tue, 20 Oct 2026 15:48:50 +0000
Subject: [PATCH] fe: push TOP-N below pre-aggregation only when ORDER BY
 covers all GROUP BY keys

PushDownTopNToPreAggRule keeps a per-pipeline top-n of the local aggregation's partial groups. With
GROUP BY a, b ORDER BY a LIMIT n, groups tied on a are cut differently in each pipeline and the global
aggregation merges incomplete partial groups (wrong sums/counts). Require the ORDER BY columns to
cover every grouping key; then the order is total and each final group survives in every pipeline.
---
 .../PushDownTopNToPreAggRule.java             | 13 +++-
 .../PushDownTopNToPreAggRuleTest.java         | 65 +++++++++++++++++++
 2 files changed, 77 insertions(+), 1 deletion(-)
 create mode 100644 fe/fe-core/src/test/java/com/starrocks/sql/optimizer/rule/transformation/PushDownTopNToPreAggRuleTest.java

diff --git a/fe/fe-core/src/main/java/com/starrocks/sql/optimizer/rule/transformation/PushDownTopNToPreAggRule.java b/fe/fe-core/src/main/java/com/starrocks/sql/optimizer/rule/transformation/PushDownTopNToPreAggRule.java
index 4298a01b..c6d8bbdf 100644
--- a/fe/fe-core/src/main/java/com/starrocks/sql/optimizer/rule/transformation/PushDownTopNToPreAggRule.java
+++ b/fe/fe-core/src/main/java/com/starrocks/sql/optimizer/rule/transformation/PushDownTopNToPreAggRule.java
@@ -31,6 +31,8 @@ import com.starrocks.sql.optimizer.operator.scalar.ColumnRefOperator;
 import com.starrocks.sql.optimizer.rule.RuleType;
 
 import java.util.List;
+import java.util.Set;
+import java.util.stream.Collectors;
 
 /*
  * When a top-n operator follows after a 2 phase aggregation, and the top-n order by columns do not depend
@@ -125,7 +127,16 @@ public class PushDownTopNToPreAggRule extends TransformationRule {
         // verify aggregation result columns are not used in the order by columns of topN.
         List<Ordering> orderByElements = topn.getOrderByElements();
         List<ColumnRefOperator> groupingKeys = aggGlobal.getGroupingKeys();
-        return orderByElements.stream().allMatch(orderByElement -> groupingKeys.contains(orderByElement.getColumnRef()));
+        if (!orderByElements.stream().allMatch(ordering -> groupingKeys.contains(ordering.getColumnRef()))) {
+            return false;
+        }
+        // The order by columns must also cover every grouping key. Otherwise groups that tie on the order by
+        // columns (GROUP BY a, b ORDER BY a LIMIT n) are cut differently in each pipeline, and the global
+        // aggregation merges incomplete partial groups (wrong results). With all grouping keys the order is
+        // total, so every group of the final top-n is among the first n groups of each pipeline.
+        Set<ColumnRefOperator> orderByColumns =
+                orderByElements.stream().map(Ordering::getColumnRef).collect(Collectors.toSet());
+        return orderByColumns.containsAll(groupingKeys);
     }
 
     @Override
diff --git a/fe/fe-core/src/test/java/com/starrocks/sql/optimizer/rule/transformation/PushDownTopNToPreAggRuleTest.java b/fe/fe-core/src/test/java/com/starrocks/sql/optimizer/rule/transformation/PushDownTopNToPreAggRuleTest.java
