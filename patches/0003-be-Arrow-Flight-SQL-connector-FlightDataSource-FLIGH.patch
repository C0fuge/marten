+
+// Arrow Flight SQL external catalog (FE catalog type "flight"). The FE plans one Flight SQL query per scan
+// (GetFlightInfo) and sends every FlightEndpoint as one TFlightScanRange; each data source reads one endpoint
+// with DoGet and converts the Arrow record batches into chunks. Arrow field i fills slot i of the tuple.
+class FlightConnector final : public Connector {
+public:
+    ~FlightConnector() override = default;
+
+    DataSourceProviderPtr create_data_source_provider(ConnectorScanNode* scan_node,
+                                                      const TPlanNode& plan_node) const override;
+
+    ConnectorType connector_type() const override { return ConnectorType::FLIGHT; }
+};
+
+class FlightDataSourceProvider final : public DataSourceProvider {
+public:
+    FlightDataSourceProvider(ConnectorScanNode* scan_node, const TPlanNode& plan_node);
+    ~FlightDataSourceProvider() override = default;
+
+    DataSourcePtr create_data_source(const TScanRange& scan_range) override;
+    const TupleDescriptor* tuple_descriptor(RuntimeState* state) const override;
+    // one endpoint per scan range; several endpoints are read in parallel
+    bool insert_local_exchange_operator() const override { return true; }
+
+    const TFlightScanNode& flight_scan_node() const { return _flight_scan_node; }
+    // memory limit per driver of the local exchange behind the scan (catalog option flight.exchange_buffer_mb);
+    // 0 = StarRocks default (local_exchange_buffer_mem_limit_per_driver)
+    int64_t exchange_buffer_bytes_per_driver() const;
+
+private:
+    ConnectorScanNode* _scan_node;
+    const TFlightScanNode _flight_scan_node;
+};
+
+class FlightDataSource final : public DataSource {
+public:
+    FlightDataSource(const FlightDataSourceProvider* provider, const TScanRange& scan_range);
+    ~FlightDataSource() override;
+
+    std::string name() const override { return "FlightDataSource"; }
+    Status open(RuntimeState* state) override;
+    void close(RuntimeState* state) override;
+    Status get_next(RuntimeState* state, ChunkPtr* chunk) override;
+
+    int64_t raw_rows_read() const override { return _rows_read; }
+    int64_t num_rows_read() const override { return _rows_returned; }
+    int64_t num_bytes_read() const override { return _bytes_read; }
+    int64_t cpu_time_spent() const override { return _cpu_time_ns; }
+    int64_t io_time_spent() const override { return _io_time_ns; }
+    bool can_estimate_mem_usage() const override { return true; }
+    int64_t estimated_mem_usage() const override { return _last_batch_bytes; }
+
+    // Called by the cancel watcher thread.
+    void cancel_stream();
+    RuntimeState* runtime_state() const { return _runtime_state; }
+
+private:
+    Status _start_stream();
+    arrow::Status _connect_and_get(const std::string& location);
+    Status _check_schema(const arrow::Schema& schema);
+    Status _next_batch(bool* eof);
+    Status _convert(size_t num_rows, ChunkPtr* chunk);
+    void _release_stream();
+    void _init_counters();
+
+    const FlightDataSourceProvider* _provider;
+    const TFlightScanRange _scan_range;
+    bool _has_range = false;
+
+    RuntimeState* _runtime_state = nullptr;
+    std::vector<SlotDescriptor*> _slots;
+    std::vector<std::string> _locations;
+    size_t _location_idx = 0;
+
+    std::unique_ptr<arrow::flight::FlightClient> _client;
+    std::unique_ptr<arrow::flight::FlightStreamReader> _reader;
+    std::mutex _reader_lock; // guards _reader against cancel_stream() from the watcher thread
+    bool _registered = false;
+
+    std::shared_ptr<arrow::RecordBatch> _batch;
+    size_t _batch_offset = 0;
+    bool _delivered = false; // at least one batch was returned: no failover any more
+    bool _eof = false;
+
+    ArrowConvertContext _conv_ctx;
+    // per stream: one converter, cast expr and empty column prototype per slot
+    ObjectPool _conv_pool;
+    std::vector<std::unique_ptr<ConvertFuncTree>> _conv_funcs;
+    std::vector<Expr*> _cast_exprs;
+    std::vector<MutableColumnPtr> _column_protos;
+
+    int64_t _rows_read = 0;
+    int64_t _rows_returned = 0;
+    int64_t _bytes_read = 0;
+    int64_t _cpu_time_ns = 0;
+    int64_t _io_time_ns = 0;
+    int64_t _last_batch_bytes = 0;
+
+    RuntimeProfile::Counter* _connect_timer = nullptr;
+    RuntimeProfile::Counter* _read_timer = nullptr;
+    RuntimeProfile::Counter* _convert_timer = nullptr;
+    RuntimeProfile::Counter* _batches_counter = nullptr;
+    RuntimeProfile::Counter* _rows_counter = nullptr;
+    RuntimeProfile::Counter* _bytes_counter = nullptr;
+    RuntimeProfile::Counter* _failover_counter = nullptr;
+};
+
+} // namespace starrocks::connector
